---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Contact Us — StrangerHelp" description="Get in touch with StrangerHelp. Reach us via email, Twitter/X, GitHub, or YouTube.">
  <Navbar />
  <main class="mx-auto max-w-[1400px] px-4 py-12 md:px-6">
    <div class="max-w-2xl mx-auto">
      <p class="font-mono text-xs text-mute uppercase tracking-wide mb-2">Contact</p>
      <h1 class="text-3xl font-semibold text-ink tracking-[-1.28px]">Get in Touch</h1>
      <p class="mt-2 text-sm text-body">Have questions, feedback, or need support? We'd love to hear from you.</p>

      <!-- Email -->
      <div class="mt-10 space-y-4">
        <div class="p-5 bg-canvas rounded-lg border border-hairline">
          <h2 class="text-sm font-semibold text-ink mb-3">Email Us</h2>
          <div class="space-y-3">
            <a href="mailto:helpofstranger@gmail.com" class="flex items-center gap-3 text-sm text-body hover:text-ink transition-colors">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="shrink-0"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><path d="M22 6l-10 7L2 6"/></svg>
              helpofstranger@gmail.com
            </a>
            <a href="mailto:support@strangerhelp.com" class="flex items-center gap-3 text-sm text-body hover:text-ink transition-colors">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="shrink-0"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><path d="M22 6l-10 7L2 6"/></svg>
              support@strangerhelp.com
            </a>
          </div>
        </div>

        <!-- Social Links -->
        <div class="p-5 bg-canvas rounded-lg border border-hairline">
          <h2 class="text-sm font-semibold text-ink mb-3">Follow Us</h2>
          <div class="space-y-3">
            <a href="https://x.com/strangerhelp07" target="_blank" rel="noopener" class="flex items-center gap-3 text-sm text-body hover:text-ink transition-colors">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" class="shrink-0"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              @strangerhelp07 on X (Twitter)
            </a>
            <a href="https://github.com/strangerhelp" target="_blank" rel="noopener" class="flex items-center gap-3 text-sm text-body hover:text-ink transition-colors">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" class="shrink-0"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg>
              github.com/strangerhelp
            </a>
            <a href="https://youtube.com/@strangerhelp07" target="_blank" rel="noopener" class="flex items-center gap-3 text-sm text-body hover:text-ink transition-colors">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" class="shrink-0"><path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
              youtube.com/@strangerhelp07
            </a>
          </div>
        </div>

        <!-- Support Info -->
        <div class="p-5 bg-canvas-soft rounded-lg border border-hairline">
          <h2 class="text-sm font-semibold text-ink mb-2">Support</h2>
          <p class="text-sm text-body leading-relaxed">For account issues, payment disputes, or reporting problems — email <a href="mailto:support@strangerhelp.com" class="text-link">support@strangerhelp.com</a> or use the <a href="/report" class="text-link">Report page</a>. We typically respond within 24-48 hours.</p>
        </div>
      </div>
    </div>
  </main>
  <Footer />
</Layout>
