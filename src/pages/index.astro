---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

const faqItems = [
  { q: "What is StrangerHelp?", a: "StrangerHelp is India's hyperlocal task marketplace where strangers help strangers. You can post tasks like document submissions, photo verifications, parcel pickups, or queue standing — and verified helpers near the location complete them for you." },
  { q: "How does stranger to stranger task assistance work?", a: "Post a task with a description, location, and budget. A verified helper near that location claims the task, coordinates with you via private chat, completes it with photo proof, and gets paid directly by you." },
  { q: "Is it safe to use StrangerHelp?", a: "Yes. We store all messages for accountability, require completion proofs with photos, and have a reporting system for disputes. Karma Wallet with escrow payments is coming soon for added protection." },
  { q: "Which cities does StrangerHelp operate in?", a: "StrangerHelp is live in Delhi, Mumbai, Bangalore, Chennai, Hyderabad, Pune, Kolkata, Ahmedabad, and expanding to more cities globally. The platform works anywhere — post a task in any city." },
  { q: "How do I get paid as a helper?", a: "Currently, task posters pay helpers directly via UPI, bank transfer, PayPal, or other agreed methods. Verify payment terms via in-app messages before starting. Karma Wallet escrow is coming soon." },
  { q: "Can I post tasks anonymously?", a: "Yes. StrangerHelp supports anonymous task posting where only your area is shown. Your identity stays hidden until you choose to reveal it in the private chat." },
];

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
});

const businessSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "StrangerHelp",
  "url": "https://strangerhelp.com",
  "logo": "https://strangerhelp.com/favicon.svg",
  "description": "A hyperlocal task marketplace where strangers help strangers with document submissions, photo verifications, parcel pickups, and crowdsourced local information.",
  "areaServed": { "@type": "Place", "name": "Worldwide" },
  "sameAs": ["https://x.com/strangerhelp07", "https://github.com/strangerhelp", "https://youtube.com/@strangerhelp07"]
});

const cities = ["Delhi", "Mumbai", "Bangalore", "Chennai", "Hyderabad", "Pune", "Kolkata", "Ahmedabad"];
---

<Layout>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={faqSchema} />
    <script type="application/ld+json" set:html={businessSchema} />
  </Fragment>

  <Navbar />
  <main>
    <!-- Hero Section -->
    <section class="relative overflow-hidden bg-canvas">
      <div class="absolute inset-0 opacity-30" aria-hidden="true">
        <div class="absolute top-0 left-1/4 w-96 h-96 bg-gradient-develop-start rounded-full blur-[128px]"></div>
        <div class="absolute top-20 right-1/4 w-80 h-80 bg-gradient-preview-start rounded-full blur-[128px]"></div>
        <div class="absolute bottom-0 left-1/2 w-72 h-72 bg-gradient-ship-end rounded-full blur-[128px]"></div>
      </div>

      <div class="relative mx-auto max-w-[1400px] px-4 py-24 md:py-40 md:px-6 text-center">
        <a href="/how-it-works" class="inline-flex items-center gap-2 px-3 py-1 mb-6 text-sm text-body bg-canvas-soft rounded-full border border-hairline hover:border-hairline-strong transition-colors">
          <span class="inline-block w-1.5 h-1.5 rounded-full bg-cyan"></span>
          Now live in 50+ cities worldwide
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" class="text-mute"><path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>

        <h1 class="text-4xl md:text-[48px] font-semibold leading-tight md:leading-[48px] tracking-[-2.4px] text-ink max-w-3xl mx-auto">
          Stranger Help — Get Tasks Done<br class="hidden md:block" /> Anywhere, Anytime
        </h1>

        <p class="mt-5 text-lg text-body max-w-xl mx-auto leading-7">
          The hyperlocal task marketplace where strangers help strangers. Post a task, get matched with a verified helper nearby, and get things done — document submissions, photo verifications, parcel pickups, queue standing, and more.
        </p>

        <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
          <a href="/register" class="inline-flex h-12 items-center px-6 text-base font-medium text-on-primary bg-primary rounded-full hover:opacity-90 transition-opacity">Get Started Free</a>
          <a href="/tasks" class="inline-flex h-12 items-center px-6 text-base font-medium text-ink bg-canvas border border-hairline rounded-full hover:border-hairline-strong transition-colors">Browse Tasks</a>
        </div>
      </div>
    </section>

    <!-- What is StrangerHelp - SEO Content -->
    <section class="border-t border-hairline bg-canvas-soft">
      <div class="mx-auto max-w-[1400px] px-4 py-24 md:px-6 md:py-32">
        <div class="max-w-3xl mx-auto">
          <h2 class="text-2xl md:text-[32px] font-semibold leading-tight tracking-[-1.28px] text-ink">
            What is StrangerHelp? The Global Task Assistance Marketplace
          </h2>
          <div class="mt-6 text-sm text-body leading-relaxed space-y-4">
            <p>StrangerHelp is a <strong>hyperlocal task marketplace</strong> where strangers help strangers get things done. Whether you need someone to submit documents at a government office across town, take a photo of a specific location, stand in a queue on your behalf, pick up a parcel, or verify if a shop is open — StrangerHelp connects you with <strong>verified helpers</strong> in that exact area.</p>
            <p>Unlike traditional gig platforms, StrangerHelp focuses on <strong>micro-tasks that require physical presence</strong> at a specific location. Our <strong>stranger to stranger</strong> model means anyone can help anyone — building community trust one task at a time. With <strong>anonymous task posting</strong>, you can request help without revealing your identity until you're comfortable.</p>
            <p>StrangerHelp also serves as a <strong>crowdsourced information</strong> hub where you can ask questions about your city — Is the passport office open today? What's the wait time at the hospital? Is there flooding near the station? — and get real-time answers from locals who are actually there.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- How it works -->
    <section class="border-t border-hairline bg-canvas">
      <div class="mx-auto max-w-[1400px] px-4 py-24 md:px-6 md:py-32">
        <p class="font-mono text-xs text-mute uppercase tracking-wide text-center mb-3">How it works</p>
        <h2 class="text-2xl md:text-[32px] font-semibold leading-tight tracking-[-1.28px] text-ink text-center">Three steps to get tasks done</h2>

        <div class="mt-16 grid grid-cols-1 md:grid-cols-3 gap-8">
          <div class="p-6 bg-canvas rounded-lg border border-hairline shadow-[0px_1px_1px_#00000005,0px_2px_2px_#0000000a]">
            <div class="w-10 h-10 flex items-center justify-center rounded-full bg-canvas-soft-2 text-sm font-mono font-medium text-ink mb-4">01</div>
            <h3 class="text-lg font-semibold text-ink tracking-tight">Post your task</h3>
            <p class="mt-2 text-sm text-body leading-relaxed">Describe what you need done — document submission, photo proof, parcel pickup, or queue standing. Set location, budget, and deadline.</p>
          </div>
          <div class="p-6 bg-canvas rounded-lg border border-hairline shadow-[0px_1px_1px_#00000005,0px_2px_2px_#0000000a]">
            <div class="w-10 h-10 flex items-center justify-center rounded-full bg-canvas-soft-2 text-sm font-mono font-medium text-ink mb-4">02</div>
            <h3 class="text-lg font-semibold text-ink tracking-tight">A verified helper claims it</h3>
            <p class="mt-2 text-sm text-body leading-relaxed">Verified strangers near the location see your task and claim it. Chat in real-time to coordinate details and confirm payment terms.</p>
          </div>
          <div class="p-6 bg-canvas rounded-lg border border-hairline shadow-[0px_1px_1px_#00000005,0px_2px_2px_#0000000a]">
            <div class="w-10 h-10 flex items-center justify-center rounded-full bg-canvas-soft-2 text-sm font-mono font-medium text-ink mb-4">03</div>
            <h3 class="text-lg font-semibold text-ink tracking-tight">Task done. Pay securely.</h3>
            <p class="mt-2 text-sm text-body leading-relaxed">Helper submits photo proof of completion. You verify and pay directly via UPI. Both parties rate each other for trust building.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Task Categories - SEO keyword rich -->
    <section class="border-t border-hairline bg-canvas-soft">
      <div class="mx-auto max-w-[1400px] px-4 py-24 md:px-6 md:py-32">
        <h2 class="text-2xl md:text-[32px] font-semibold leading-tight tracking-[-1.28px] text-ink text-center">Task Categories — What Can You Get Done?</h2>
        <p class="mt-4 text-base text-body text-center max-w-xl mx-auto">From document submissions to photo verifications, StrangerHelp covers every hyperlocal task you need help with.</p>

        <div class="mt-12 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {[
            { title: "Document Submission", desc: "Submit applications, forms, and paperwork at government offices, banks, or institutions.", href: "/category/document-submission" },
            { title: "Photo Verification", desc: "Get geo-tagged photos of locations, shops, buildings, or documents for proof.", href: "/category/photo-proof" },
            { title: "Parcel Pickup & Delivery", desc: "Pick up or drop off parcels, couriers, and documents across your city.", href: "/category/parcel-pickup" },
            { title: "Queue Standing", desc: "Someone stands in line for you at passport offices, hospitals, banks, or ticket counters.", href: "/category/queue-standing" },
            { title: "Simple Survey", desc: "Collect on-ground information, check prices, or survey locations.", href: "/category/simple-survey" },
            { title: "Receipt Collection", desc: "Collect receipts, acknowledgments, or signed documents from any location.", href: "/category/receipt-collection" },
            { title: "Verification Tasks", desc: "Verify if a shop is open, check office timings, or confirm address details.", href: "/category/verification" },
            { title: "Other Tasks", desc: "Any task that needs physical presence — from event checks to local errands.", href: "/category/other" },
          ].map((cat) => (
            <a href={cat.href} class="p-5 bg-canvas rounded-lg border border-hairline hover:border-hairline-strong transition-colors">
              <h3 class="text-sm font-semibold text-ink">{cat.title}</h3>
              <p class="mt-1.5 text-xs text-body leading-relaxed">{cat.desc}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Two Dimensions -->
    <section class="border-t border-hairline bg-canvas">
      <div class="mx-auto max-w-[1400px] px-4 py-24 md:px-6 md:py-32">
        <h2 class="text-2xl md:text-[32px] font-semibold leading-tight tracking-[-1.28px] text-ink text-center max-w-2xl mx-auto">More Than a Task Marketplace — A Community Knowledge Hub</h2>

        <div class="mt-16 grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="p-8 bg-canvas-soft rounded-xl border border-hairline">
            <div class="inline-flex items-center gap-2 px-2.5 py-1 text-xs font-medium text-on-primary bg-primary rounded-full mb-4">Primary</div>
            <h3 class="text-xl font-semibold text-ink tracking-tight">Task Assistance</h3>
            <p class="mt-3 text-sm text-body leading-relaxed">Need a document submitted across town? A photo of a building? Someone to stand in a queue? Post it — a verified stranger near that location gets it done.</p>
            <ul class="mt-5 space-y-2.5 text-sm text-body">
              <li class="flex items-start gap-2.5"><svg class="w-4 h-4 mt-0.5 text-cyan-deep shrink-0" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>Document submission & collection</li>
              <li class="flex items-start gap-2.5"><svg class="w-4 h-4 mt-0.5 text-cyan-deep shrink-0" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>Photo verification & proof</li>
              <li class="flex items-start gap-2.5"><svg class="w-4 h-4 mt-0.5 text-cyan-deep shrink-0" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>Parcel pickup & delivery</li>
              <li class="flex items-start gap-2.5"><svg class="w-4 h-4 mt-0.5 text-cyan-deep shrink-0" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>Queue standing & appointments</li>
            </ul>
          </div>
          <div class="p-8 bg-primary rounded-xl text-on-primary">
            <div class="inline-flex items-center gap-2 px-2.5 py-1 text-xs font-medium text-ink bg-canvas rounded-full mb-4">Secondary</div>
            <h3 class="text-xl font-semibold tracking-tight">Crowdsourced Local Information</h3>
            <p class="mt-3 text-sm leading-relaxed opacity-80">Ask anything about your city anonymously. Get real-time answers from locals — government office hours, traffic updates, hospital wait times, emergency contacts.</p>
            <ul class="mt-5 space-y-2.5 text-sm opacity-80">
              <li class="flex items-start gap-2.5"><svg class="w-4 h-4 mt-0.5 text-cyan shrink-0" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>Government office status</li>
              <li class="flex items-start gap-2.5"><svg class="w-4 h-4 mt-0.5 text-cyan shrink-0" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>Traffic & road closures</li>
              <li class="flex items-start gap-2.5"><svg class="w-4 h-4 mt-0.5 text-cyan shrink-0" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>Hospital wait times</li>
              <li class="flex items-start gap-2.5"><svg class="w-4 h-4 mt-0.5 text-cyan shrink-0" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>Emergency contacts & more</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Cities -->
    <section class="border-t border-hairline bg-canvas-soft">
      <div class="mx-auto max-w-[1400px] px-4 py-24 md:px-6 md:py-32">
        <h2 class="text-2xl md:text-[32px] font-semibold leading-tight tracking-[-1.28px] text-ink text-center">Available in Major Cities</h2>
        <p class="mt-4 text-base text-body text-center">Find verified helpers and get local task assistance in your city.</p>
        <div class="mt-12 grid grid-cols-2 md:grid-cols-4 gap-4">
          {cities.map((city) => (
            <a href={`/city/${city.toLowerCase()}`} class="p-5 bg-canvas rounded-lg border border-hairline hover:border-hairline-strong transition-colors text-center">
              <p class="text-base font-semibold text-ink">{city}</p>
              <p class="mt-1 text-xs text-mute">Task help available</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="border-t border-hairline bg-canvas">
      <div class="mx-auto max-w-[1400px] px-4 py-24 md:px-6 md:py-32">
        <h2 class="text-2xl md:text-[32px] font-semibold leading-tight tracking-[-1.28px] text-ink text-center">Frequently Asked Questions</h2>
        <div class="mt-12 max-w-2xl mx-auto space-y-4">
          {faqItems.map((faq) => (
            <details class="group p-5 bg-canvas rounded-lg border border-hairline">
              <summary class="flex items-center justify-between cursor-pointer text-sm font-semibold text-ink">
                {faq.q}
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0 transition-transform group-open:rotate-180"><path d="M6 9l6 6 6-6"/></svg>
              </summary>
              <p class="mt-3 text-sm text-body leading-relaxed">{faq.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="border-t border-hairline bg-primary text-on-primary">
      <div class="mx-auto max-w-[1400px] px-4 py-24 md:px-6 md:py-32 text-center">
        <h2 class="text-2xl md:text-[32px] font-semibold leading-tight tracking-[-1.28px]">Ready to get tasks done?</h2>
        <p class="mt-4 text-base opacity-70 max-w-md mx-auto">Join thousands of helpers and task posters across the world. Start for free.</p>
        <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
          <a href="/register" class="inline-flex h-12 items-center px-6 text-base font-medium text-ink bg-canvas rounded-full hover:bg-canvas-soft transition-colors">Create Free Account</a>
          <a href="/ask" class="inline-flex h-12 items-center px-6 text-base font-medium text-on-primary border border-on-primary/20 rounded-full hover:border-on-primary/40 transition-colors">Ask a Question</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
