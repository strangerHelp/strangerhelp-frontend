---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
---

<Layout title="Create a Meet — StrangerHelp">
  <Navbar />
  <main class="mx-auto max-w-[1400px] px-4 py-8 md:px-6">
    <div class="max-w-lg mx-auto">
      <h1 class="text-2xl font-semibold text-ink tracking-[-0.96px]">Create a Meet</h1>
      <p class="mt-2 text-sm text-body">Organize a meetup, event, or discussion. Strangers who care will join.</p>

      <form id="meet-form" class="mt-8 space-y-5">
        <div id="error-msg" class="hidden p-3 text-sm text-error bg-error-soft rounded-md"></div>

        <div>
          <label class="block text-sm font-medium text-ink mb-1.5">Title</label>
          <input type="text" id="title" required placeholder="e.g., Beach Cleanup Drive — Marina" class="w-full h-10 px-3 text-sm bg-canvas border border-hairline rounded-md focus:outline-none focus:border-ink placeholder:text-mute" />
        </div>

        <div>
          <label class="block text-sm font-medium text-ink mb-1.5">Description</label>
          <textarea id="description" rows="4" placeholder="What's the meet about? What will you do together?" class="w-full px-3 py-2.5 text-sm bg-canvas border border-hairline rounded-md focus:outline-none focus:border-ink placeholder:text-mute resize-none"></textarea>
        </div>

        <div>
          <label class="block text-sm font-medium text-ink mb-1.5">Category</label>
          <select id="category" required class="w-full h-10 px-3 text-sm bg-canvas border border-hairline rounded-md focus:outline-none focus:border-ink">
            <option value="">Select</option>
            <option>Discussion</option>
            <option>Plantation</option>
            <option>Cleanup</option>
            <option>Meetup</option>
            <option>Workshop</option>
            <option>Sports</option>
            <option>Social</option>
            <option>Other</option>
          </select>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-ink mb-1.5">Date</label>
            <input type="date" id="date" class="w-full h-10 px-3 text-sm bg-canvas border border-hairline rounded-md focus:outline-none focus:border-ink" />
          </div>
          <div>
            <label class="block text-sm font-medium text-ink mb-1.5">Time</label>
            <input type="time" id="time" class="w-full h-10 px-3 text-sm bg-canvas border border-hairline rounded-md focus:outline-none focus:border-ink" />
          </div>
        </div>

        <div>
          <label class="block text-sm font-medium text-ink mb-1.5">Location</label>
          <input type="text" id="location" placeholder="Park name, address, or 'Online'" class="w-full h-10 px-3 text-sm bg-canvas border border-hairline rounded-md focus:outline-none focus:border-ink placeholder:text-mute" />
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-ink mb-1.5">Visibility</label>
            <select id="visibility" class="w-full h-10 px-3 text-sm bg-canvas border border-hairline rounded-md focus:outline-none focus:border-ink">
              <option value="public">🌐 Public (anyone can join)</option>
              <option value="private">🔒 Private (invite link only)</option>
            </select>
          </div>
          <div>
            <label class="block text-sm font-medium text-ink mb-1.5">Max Attendees</label>
            <input type="number" id="max-attendees" value="50" min="2" max="500" class="w-full h-10 px-3 text-sm bg-canvas border border-hairline rounded-md focus:outline-none focus:border-ink" />
          </div>
        </div>

        <!-- Voice Note -->
        <div>
          <label class="block text-sm font-medium text-ink mb-1.5">Voice Note <span class="text-mute font-normal">(optional)</span></label>
          <div class="p-3 bg-canvas-soft rounded-md border border-hairline">
            <div id="vn-idle" class="flex items-center justify-between">
              <p class="text-xs text-mute">Describe the meet in your voice</p>
              <button type="button" id="vn-start" class="h-8 px-3 flex items-center gap-1.5 text-xs font-medium text-ink border border-hairline rounded-full hover:bg-canvas-soft-2">🎤 Record</button>
            </div>
            <div id="vn-recording" class="hidden flex items-center justify-between">
              <div class="flex items-center gap-2"><span class="w-2.5 h-2.5 rounded-full bg-error animate-pulse"></span><span id="vn-timer" class="text-xs font-mono text-error">00:00</span></div>
              <button type="button" id="vn-stop" class="h-8 px-3 text-xs font-medium text-error border border-error/30 rounded-full">Stop</button>
            </div>
            <div id="vn-done" class="hidden flex items-center justify-between">
              <audio id="vn-audio" controls class="h-8 flex-1"></audio>
              <button type="button" id="vn-remove" class="ml-2 text-xs text-error hover:underline">Remove</button>
            </div>
          </div>
        </div>

        <button type="submit" id="submit-btn" class="w-full h-11 flex items-center justify-center text-sm font-medium text-on-primary bg-primary rounded-full hover:opacity-90 transition-opacity">Create Meet</button>
      </form>
    </div>
  </main>
</Layout>

<script>
  fetch('/api/auth/me').then(r => { if (!r.ok) window.location.href = '/login?redirect=/meets/new'; });

  let voiceBlob: Blob | null = null;
  let recorder: MediaRecorder | null = null;
  let chunks: Blob[] = [];
  let timerInt: any, secs = 0;

  document.getElementById('vn-start')!.addEventListener('click', async () => {
    try {
      const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
      chunks = []; recorder = new MediaRecorder(stream);
      recorder.ondataavailable = e => { if (e.data.size > 0) chunks.push(e.data); };
      recorder.onstop = () => { voiceBlob = new Blob(chunks, { type: 'audio/webm' }); (document.getElementById('vn-audio') as HTMLAudioElement).src = URL.createObjectURL(voiceBlob); document.getElementById('vn-recording')!.classList.add('hidden'); document.getElementById('vn-done')!.classList.remove('hidden'); stream.getTracks().forEach(t => t.stop()); };
      recorder.start(); secs = 0;
      document.getElementById('vn-idle')!.classList.add('hidden'); document.getElementById('vn-recording')!.classList.remove('hidden');
      timerInt = setInterval(() => { secs++; document.getElementById('vn-timer')!.textContent = `${String(Math.floor(secs/60)).padStart(2,'0')}:${String(secs%60).padStart(2,'0')}`; }, 1000);
    } catch { alert('Microphone access denied'); }
  });
  document.getElementById('vn-stop')!.addEventListener('click', () => { recorder?.stop(); clearInterval(timerInt); });
  document.getElementById('vn-remove')!.addEventListener('click', () => { voiceBlob = null; document.getElementById('vn-done')!.classList.add('hidden'); document.getElementById('vn-idle')!.classList.remove('hidden'); });

  document.getElementById('meet-form')!.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.getElementById('submit-btn')!;
    btn.textContent = 'Creating...';

    const fd = new FormData();
    fd.append('title', (document.getElementById('title') as HTMLInputElement).value);
    fd.append('description', (document.getElementById('description') as HTMLTextAreaElement).value);
    fd.append('category', (document.getElementById('category') as HTMLSelectElement).value);
    fd.append('date', (document.getElementById('date') as HTMLInputElement).value);
    fd.append('time', (document.getElementById('time') as HTMLInputElement).value);
    fd.append('location', (document.getElementById('location') as HTMLInputElement).value);
    fd.append('visibility', (document.getElementById('visibility') as HTMLSelectElement).value);
    fd.append('max_attendees', (document.getElementById('max-attendees') as HTMLInputElement).value);
    if (voiceBlob) fd.append('voice_note', new File([voiceBlob], 'voice.webm', { type: 'audio/webm' }));

    const res = await fetch('/api/meets', { method: 'POST', body: fd });
    const data = await res.json();
    if (res.ok) { window.location.href = `/meets/${data.id}`; }
    else { document.getElementById('error-msg')!.textContent = data.error; document.getElementById('error-msg')!.classList.remove('hidden'); btn.textContent = 'Create Meet'; }
  });
</script>
