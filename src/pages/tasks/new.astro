---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
---

<Layout title="Post a Task — StrangerHelp">
  <Navbar />
  <main class="mx-auto max-w-[1400px] px-4 py-8 md:px-6">
    <div class="max-w-lg mx-auto">
      <h1 class="text-2xl font-semibold text-ink tracking-[-0.96px]">Post a new task.</h1>
      <p class="mt-2 text-sm text-body">Describe what you need done. A helper near the location will claim it.</p>

      <form id="task-form" class="mt-8 space-y-5" enctype="multipart/form-data">
        <div id="error-msg" class="hidden p-3 text-sm text-error bg-error-soft rounded-md"></div>
        <div id="success-msg" class="hidden p-3 text-sm text-cyan-deep bg-cyan-soft rounded-md"></div>

        <div>
          <label for="title" class="block text-sm font-medium text-ink mb-1.5">Task Title</label>
          <input type="text" id="title" name="title" required placeholder="e.g., Submit documents at RTO" class="w-full h-10 px-3 text-sm bg-canvas border border-hairline rounded-md focus:outline-none focus:border-ink transition-colors placeholder:text-mute" />
        </div>

        <div>
          <label for="description" class="block text-sm font-medium text-ink mb-1.5">Description</label>
          <textarea id="description" name="description" rows="4" placeholder="Provide details about what needs to be done..." class="w-full px-3 py-2.5 text-sm bg-canvas border border-hairline rounded-md focus:outline-none focus:border-ink transition-colors placeholder:text-mute resize-none"></textarea>
        </div>

        <div>
          <label for="category" class="block text-sm font-medium text-ink mb-1.5">Category</label>
          <select id="category" name="category" required class="w-full h-10 px-3 text-sm bg-canvas border border-hairline rounded-md focus:outline-none focus:border-ink transition-colors">
            <option value="">Select category</option>
            <option>Simple Survey</option>
            <option>Task</option>
            <option>Document Submission</option>
            <option>Photo Proof</option>
            <option>Parcel Pickup</option>
            <option>Queue Standing</option>
            <option>Verification</option>
            <option>Receipt Collection</option>
            <option>Other</option>
          </select>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="budget" class="block text-sm font-medium text-ink mb-1.5">Budget (₹)</label>
            <input type="number" id="budget" name="budget" required min="10" placeholder="e.g., 350" class="w-full h-10 px-3 text-sm bg-canvas border border-hairline rounded-md focus:outline-none focus:border-ink transition-colors placeholder:text-mute" />
          </div>
          <div>
            <label class="block text-sm font-medium text-ink mb-1.5">Deadline</label>
            <select id="deadline-select" class="w-full h-10 px-3 text-sm bg-canvas border border-hairline rounded-md focus:outline-none focus:border-ink transition-colors">
              <option value="Within 1 hour">Within 1 hour</option>
              <option value="Within 2 hours">Within 2 hours</option>
              <option value="Within 4 hours">Within 4 hours</option>
              <option value="Today" selected>Today</option>
              <option value="Tomorrow">Tomorrow</option>
              <option value="custom">Custom</option>
            </select>
          </div>
        </div>

        <!-- Custom date/time picker (hidden by default) -->
        <div id="custom-deadline" class="hidden grid grid-cols-2 gap-4">
          <div>
            <label for="custom-date" class="block text-sm font-medium text-ink mb-1.5">Date</label>
            <input type="date" id="custom-date" class="w-full h-10 px-3 text-sm bg-canvas border border-hairline rounded-md focus:outline-none focus:border-ink transition-colors" />
          </div>
          <div>
            <label for="custom-time" class="block text-sm font-medium text-ink mb-1.5">Time</label>
            <input type="time" id="custom-time" class="w-full h-10 px-3 text-sm bg-canvas border border-hairline rounded-md focus:outline-none focus:border-ink transition-colors" />
          </div>
        </div>

        <div>
          <label for="location" class="block text-sm font-medium text-ink mb-1.5">Location</label>
          <input type="text" id="location" name="location" required placeholder="Area, landmark, or address" class="w-full h-10 px-3 text-sm bg-canvas border border-hairline rounded-md focus:outline-none focus:border-ink transition-colors placeholder:text-mute" />
        </div>

        <div>
          <label class="block text-sm font-medium text-ink mb-1.5">Attachments (photos, documents)</label>
          <input type="file" id="files" name="files" multiple accept="image/*,.pdf,.doc,.docx" class="hidden" />
          <div id="file-drop" class="flex items-center justify-center h-24 border-2 border-dashed border-hairline rounded-md hover:border-hairline-strong transition-colors cursor-pointer">
            <div class="text-center">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="mx-auto text-mute"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M17 8l-5-5-5 5M12 3v12"/></svg>
              <p class="mt-1 text-xs text-mute">Click to upload photos or documents</p>
            </div>
          </div>
          <div id="file-list" class="mt-2 flex flex-wrap gap-2"></div>
        </div>

        <!-- Urgent toggle -->
        <div class="flex items-center justify-between p-4 bg-error-soft/50 rounded-md border border-error/20">
          <div>
            <p class="text-sm font-medium text-ink">⚡ Mark as Urgent</p>
            <p class="text-xs text-mute mt-0.5">Helpers will prioritize your task.</p>
          </div>
          <input type="checkbox" id="urgent" name="urgent" class="w-5 h-5 rounded border-hairline accent-error" />
        </div>

        <!-- Anonymous toggle -->
        <div class="flex items-center justify-between p-4 bg-canvas-soft rounded-md border border-hairline">
          <div>
            <p class="text-sm font-medium text-ink">Post anonymously</p>
            <p class="text-xs text-mute mt-0.5">Your identity will be hidden.</p>
          </div>
          <input type="checkbox" id="anonymous" name="anonymous" class="w-5 h-5 rounded border-hairline" />
        </div>

        <button type="submit" id="submit-btn" class="w-full h-11 flex items-center justify-center text-sm font-medium text-on-primary bg-primary rounded-full hover:opacity-90 transition-opacity">
          Post Task
        </button>
      </form>
    </div>
  </main>
</Layout>

<!-- Urgent budget popup modal -->
<div id="urgent-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-ink/50 backdrop-blur-sm">
  <div class="bg-canvas rounded-lg border border-hairline shadow-xl p-6 max-w-sm mx-4">
    <div class="flex items-center gap-2 mb-3">
      <span class="text-xl">⚡</span>
      <h3 class="text-base font-semibold text-ink">Urgent Task Tip</h3>
    </div>
    <p class="text-sm text-body leading-relaxed">Consider setting a <strong>higher budget</strong> for urgent tasks. Helpers are more likely to claim and complete your task quickly when the reward is higher.</p>
    <div class="mt-4 flex gap-2">
      <button id="urgent-increase" class="flex-1 h-9 text-sm font-medium text-on-primary bg-primary rounded-md hover:opacity-90">Increase Budget</button>
      <button id="urgent-dismiss" class="flex-1 h-9 text-sm font-medium text-ink border border-hairline rounded-md hover:bg-canvas-soft-2">Keep Current</button>
    </div>
  </div>
</div>

<script>
  fetch('/api/auth/me').then(r => { if (!r.ok) window.location.href = '/login?redirect=/tasks/new'; });

  const form = document.getElementById('task-form') as HTMLFormElement;
  const fileInput = document.getElementById('files') as HTMLInputElement;
  const fileDrop = document.getElementById('file-drop')!;
  const fileList = document.getElementById('file-list')!;
  const errorMsg = document.getElementById('error-msg')!;
  const successMsg = document.getElementById('success-msg')!;
  const submitBtn = document.getElementById('submit-btn')!;
  const deadlineSelect = document.getElementById('deadline-select') as HTMLSelectElement;
  const customDeadline = document.getElementById('custom-deadline')!;
  const urgentCheckbox = document.getElementById('urgent') as HTMLInputElement;
  const urgentModal = document.getElementById('urgent-modal')!;

  // Set min date to today
  const today = new Date().toISOString().split('T')[0];
  (document.getElementById('custom-date') as HTMLInputElement).min = today;
  (document.getElementById('custom-date') as HTMLInputElement).value = today;

  // Deadline: show/hide custom picker
  deadlineSelect.addEventListener('change', () => {
    customDeadline.classList.toggle('hidden', deadlineSelect.value !== 'custom');
  });

  // Urgent: show popup when checked
  urgentCheckbox.addEventListener('change', () => {
    if (urgentCheckbox.checked) {
      urgentModal.classList.remove('hidden');
    }
  });

  document.getElementById('urgent-increase')!.addEventListener('click', () => {
    const budgetInput = document.getElementById('budget') as HTMLInputElement;
    const current = parseInt(budgetInput.value) || 0;
    budgetInput.value = String(Math.max(current + 100, Math.round(current * 1.5)));
    budgetInput.focus();
    urgentModal.classList.add('hidden');
  });

  document.getElementById('urgent-dismiss')!.addEventListener('click', () => {
    urgentModal.classList.add('hidden');
  });

  fileDrop.addEventListener('click', () => fileInput.click());
  fileInput.addEventListener('change', () => {
    fileList.innerHTML = Array.from(fileInput.files || []).map(f =>
      `<span class="px-2 py-1 text-xs bg-canvas-soft-2 rounded border border-hairline">${f.name}</span>`
    ).join('');
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorMsg.classList.add('hidden');
    successMsg.classList.add('hidden');
    submitBtn.textContent = 'Posting...';
    submitBtn.setAttribute('disabled', 'true');

    // Build deadline value
    let deadline = deadlineSelect.value;
    if (deadline === 'custom') {
      const date = (document.getElementById('custom-date') as HTMLInputElement).value;
      const time = (document.getElementById('custom-time') as HTMLInputElement).value;
      if (!date) { errorMsg.textContent = 'Please select a date'; errorMsg.classList.remove('hidden'); submitBtn.textContent = 'Post Task'; submitBtn.removeAttribute('disabled'); return; }
      deadline = time ? `${date} ${time}` : date;
    }

    const fd = new FormData();
    fd.append('title', (document.getElementById('title') as HTMLInputElement).value);
    fd.append('description', (document.getElementById('description') as HTMLTextAreaElement).value);
    fd.append('category', (document.getElementById('category') as HTMLSelectElement).value);
    fd.append('budget', (document.getElementById('budget') as HTMLInputElement).value);
    fd.append('deadline', deadline);
    fd.append('location', (document.getElementById('location') as HTMLInputElement).value);
    fd.append('anonymous', (document.getElementById('anonymous') as HTMLInputElement).checked ? 'true' : 'false');
    fd.append('urgent', urgentCheckbox.checked ? 'true' : 'false');

    const files = fileInput.files;
    if (files && files.length > 0) {
      const compressed = await (window as any).compressFiles(files);
      for (const f of compressed) fd.append('files', f);
    }

    try {
      const res = await fetch('/api/tasks', { method: 'POST', body: fd });
      const data = await res.json();
      if (!res.ok) {
        errorMsg.textContent = data.error || 'Failed to post task';
        errorMsg.classList.remove('hidden');
      } else {
        successMsg.textContent = 'Task posted successfully! Redirecting...';
        successMsg.classList.remove('hidden');
        setTimeout(() => window.location.href = `/tasks/${data.id}`, 1000);
      }
    } catch {
      errorMsg.textContent = 'Network error. Try again.';
      errorMsg.classList.remove('hidden');
    }

    submitBtn.textContent = 'Post Task';
    submitBtn.removeAttribute('disabled');
  });
</script>
