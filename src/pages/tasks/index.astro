---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";

const categories = ["All", "Simple Survey", "Task", "Document Submission", "Photo Proof", "Parcel Pickup", "Queue Standing", "Verification", "Receipt Collection", "Other"];
---

<Layout title="Browse Tasks — StrangerHelp">
  <Navbar />
  <main class="mx-auto max-w-[1400px] px-4 py-8 md:px-6">
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-8">
      <div>
        <h1 class="text-2xl font-semibold text-ink tracking-[-0.96px]">Available Tasks</h1>
        <p class="mt-1 text-sm text-body">Tasks waiting to be claimed.</p>
      </div>
      <a href="/tasks/new" class="inline-flex h-10 items-center px-4 text-sm font-medium text-on-primary bg-primary rounded-full hover:opacity-90 transition-opacity">+ Post a Task</a>
    </div>

    <!-- Location banner -->
    <div id="location-banner" class="mb-6 p-4 bg-canvas rounded-lg border border-hairline">
      <!-- State 1: Ask for location -->
      <div id="loc-ask" class="flex items-center justify-between gap-3">
        <div class="flex items-center gap-3">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-link shrink-0"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
          <div>
            <p class="text-sm font-medium text-ink" id="location-text">Enable location for nearby tasks</p>
            <p class="text-xs text-mute" id="location-sub">See tasks sorted by distance from you</p>
          </div>
        </div>
        <button id="location-btn" class="shrink-0 h-8 px-3 text-xs font-medium text-on-primary bg-primary rounded-md hover:opacity-90 transition-opacity">Allow Location</button>
      </div>
      <!-- State 2: City input (shown if GPS denied and not logged in with city) -->
      <div id="loc-city" class="hidden">
        <div class="flex items-center justify-between mb-2">
          <div class="flex items-center gap-3">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-link shrink-0"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <p class="text-sm font-medium text-ink">Enter your city to see nearby tasks</p>
          </div>
          <button id="live-location-btn" class="shrink-0 h-8 px-3 text-xs font-medium text-link border border-hairline rounded-md hover:bg-canvas-soft-2">📍 Use Live Location</button>
        </div>
        <div class="relative">
          <input type="text" id="city-input" placeholder="Search city or area..." autocomplete="off" class="w-full h-10 px-3 text-sm bg-canvas border border-hairline rounded-md focus:outline-none focus:border-ink transition-colors placeholder:text-mute" />
          <div id="city-results" class="hidden absolute z-20 left-0 right-0 top-11 bg-canvas border border-hairline rounded-md shadow-lg max-h-48 overflow-y-auto"></div>
        </div>
      </div>
      <!-- State 3: Location active -->
      <div id="loc-active" class="hidden flex items-center justify-between gap-3">
        <div class="flex items-center gap-3">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-cyan-deep shrink-0"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
          <div>
            <p class="text-sm font-medium text-ink">Tasks near <span id="loc-name" class="text-link"></span></p>
            <p class="text-xs text-mute">Sorted by distance</p>
          </div>
        </div>
        <button id="change-location-btn" class="shrink-0 h-8 px-3 text-xs font-medium text-ink border border-hairline rounded-md hover:bg-canvas-soft-2">Change</button>
      </div>
    </div>

    <!-- Search & Sort -->
    <div class="mb-4 flex flex-col sm:flex-row gap-3">
      <div class="relative flex-1">
        <svg class="absolute left-3 top-1/2 -translate-y-1/2 text-mute" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
        <input type="text" id="search-input" placeholder="Search tasks by title, location, or keyword..." class="w-full h-10 pl-9 pr-3 text-sm bg-canvas border border-hairline rounded-md focus:outline-none focus:border-ink transition-colors placeholder:text-mute" />
      </div>
      <select id="sort-select" aria-label="Sort tasks" class="h-10 px-3 text-sm bg-canvas border border-hairline rounded-md focus:outline-none focus:border-ink">
        <option value="distance">Nearest first</option>
        <option value="newest">Newest first</option>
        <option value="budget_high">Budget: High → Low</option>
        <option value="budget_low">Budget: Low → High</option>
        <option value="urgent">Urgent first</option>
      </select>
    </div>

    <!-- Filters -->
    <div class="flex gap-2 overflow-x-auto pb-4 -mx-4 px-4 md:mx-0 md:px-0">
      {categories.map((cat, i) => (
        <button data-cat={cat} class={`cat-btn shrink-0 px-4 py-2 text-sm rounded-full border transition-colors ${i === 0 ? "bg-primary text-on-primary border-primary active" : "bg-canvas text-body border-hairline hover:border-hairline-strong"}`}>
          {cat}
        </button>
      ))}
    </div>

    <!-- Task Grid -->
    <div id="tasks-grid" class="mt-6 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      <p class="col-span-full text-center text-sm text-mute py-12">Loading tasks...</p>
    </div>

    <!-- Pagination sentinel: no visible control, loads the next page on scroll -->
    <div id="load-sentinel" aria-hidden="true" class="h-px"></div>
    <p id="loading-more" class="hidden text-center text-sm text-mute py-4">Loading…</p>

    <div id="empty-state" class="hidden text-center py-16">
      <p class="text-sm text-mute">No tasks found. Be the first to post one!</p>
      <a href="/tasks/new" class="mt-4 inline-flex h-9 items-center px-4 text-sm font-medium text-on-primary bg-primary rounded-full">Post a Task</a>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  let activeCategory = 'All';
  let userLat: number | null = null;
  let userLng: number | null = null;
  let currentUser: any = null;
  let allTasks: any[] = [];
  let searchQuery = '';
  let sortBy = 'distance';

  // Server-side paging state. Search, sort and category are applied by the API
  // now; previously they were applied in the browser to whichever 20 rows had
  // been fetched, so anything beyond the first page was invisible.
  let offset = 0;
  const PAGE_SIZE = 20;
  let hasMore = false;
  let total = 0;
  let loading = false;
  let reqSeq = 0; // guards against out-of-order responses

  // The API also supports minBudget, maxBudget, maxDistance, urgent, verified
  // and status. No controls are exposed for them, so they stay at defaults.
  const filters = {
    minBudget: '', maxBudget: '', radius: '',
    status: 'open', urgentOnly: false, verifiedOnly: false,
  };

  function buildParams(): URLSearchParams {
    const params = new URLSearchParams();
    if (activeCategory && activeCategory !== 'All') params.set('category', activeCategory);
    if (searchQuery) params.set('q', searchQuery);
    params.set('sort', sortBy);
    params.set('status', filters.status);
    if (filters.minBudget) params.set('minBudget', filters.minBudget);
    if (filters.maxBudget) params.set('maxBudget', filters.maxBudget);
    if (filters.radius) params.set('maxDistance', filters.radius);
    if (filters.urgentOnly) params.set('urgent', 'true');
    if (filters.verifiedOnly) params.set('verified', 'true');
    if (userLat != null && userLng != null) {
      params.set('lat', String(userLat));
      params.set('lng', String(userLng));
    }
    params.set('limit', String(PAGE_SIZE));
    params.set('offset', String(offset));
    return params;
  }

  /** Reflect search, category and sort in the URL so results can be shared. */
  function syncUrl() {
    const p = new URLSearchParams();
    if (activeCategory !== 'All') p.set('category', activeCategory);
    if (searchQuery) p.set('q', searchQuery);
    if (sortBy !== 'distance') p.set('sort', sortBy);
    const qs = p.toString();
    history.replaceState(null, '', qs ? `?${qs}` : location.pathname);
  }

  function restoreFromUrl() {
    const p = new URLSearchParams(location.search);
    activeCategory = p.get('category') || 'All';
    searchQuery = p.get('q') || '';
    sortBy = p.get('sort') || 'distance';

    (document.getElementById('search-input') as HTMLInputElement).value = searchQuery;
    (document.getElementById('sort-select') as HTMLSelectElement).value = sortBy;

    document.querySelectorAll('.cat-btn').forEach((b) => {
      const isActive = (b as HTMLElement).dataset.cat === activeCategory;
      b.classList.toggle('bg-primary', isActive);
      b.classList.toggle('text-on-primary', isActive);
      b.classList.toggle('border-primary', isActive);
      b.classList.toggle('bg-canvas', !isActive);
      b.classList.toggle('text-body', !isActive);
      b.classList.toggle('border-hairline', !isActive);
    });
  }

  /** `reset` starts a new query; otherwise the next page is appended. */
  async function loadTasks(reset = true) {
    if (loading) return;
    loading = true;
    const seq = ++reqSeq;

    if (reset) {
      offset = 0;
      allTasks = [];
      document.getElementById('tasks-grid')!.innerHTML =
        '<p class="col-span-full text-center text-sm text-mute py-12">Loading tasks...</p>';
      document.getElementById('empty-state')!.classList.add('hidden');
    } else {
      document.getElementById('loading-more')!.classList.remove('hidden');
    }

    try {
      const res = await fetch(`/api/tasks?${buildParams()}`);
      // A newer request has been issued; discard this stale response.
      if (seq !== reqSeq) return;
      if (!res.ok) throw new Error(`HTTP ${res.status}`);

      const page = await res.json();
      total = parseInt(res.headers.get('X-Total-Count') || '0', 10);
      hasMore = res.headers.get('X-Has-More') === 'true';

      allTasks = reset ? page : allTasks.concat(page);
      offset = allTasks.length;
      renderTasks();
    } catch (e) {
      if (seq !== reqSeq) return;
      document.getElementById('tasks-grid')!.innerHTML =
        `<p class="col-span-full text-center text-sm text-error py-12">Couldn't load tasks. <button id="retry-btn" class="underline font-medium">Retry</button></p>`;
      document.getElementById('retry-btn')?.addEventListener('click', () => loadTasks(true));
    } finally {
      if (seq === reqSeq) {
        loading = false;
        document.getElementById('loading-more')!.classList.add('hidden');
      }
    }
  }

  function renderTasks() {
    const grid = document.getElementById('tasks-grid')!;
    const empty = document.getElementById('empty-state')!;

    if (allTasks.length === 0) {
      grid.innerHTML = '';
      empty.classList.remove('hidden');
      return;
    }
    empty.classList.add('hidden');

    grid.innerHTML = allTasks.map((t: any) => {
      const time = (window as any).timeAgoIST(t.createdAt);
      const distText = t.distance != null ? `${t.distance < 1 ? (t.distance * 1000).toFixed(0) + ' m' : t.distance.toFixed(1) + ' km'} away` : '';
      const deadlineColor = t.deadline?.includes('hour') ? 'text-error' : 'text-mute';
      return `<a href="/tasks/${encodeURIComponent(t._id)}" class="group p-5 bg-canvas rounded-lg border border-hairline hover:border-hairline-strong hover:shadow-md shadow-[0px_1px_1px_#00000005,0px_2px_2px_#0000000a] transition-all">
        <div class="flex items-center justify-between mb-2">
          <div class="flex items-center gap-1.5 flex-wrap">
            <span class="px-2 py-0.5 text-xs font-medium text-body bg-canvas-soft-2 rounded-full">${esc(t.category)}</span>
            ${t.urgent ? '<span class="px-2 py-0.5 text-xs font-bold bg-error-soft text-error rounded-full">⚡ Urgent</span>' : ''}
            ${t.maxClaimers > 1 ? `<span class="px-2 py-0.5 text-xs font-medium bg-violet-soft text-violet-deep rounded-full">👥 ${t.maxClaimers}</span>` : ''}
          </div>
          <span class="text-lg font-bold text-ink">₹${t.budget}${t.maxClaimers > 1 ? '<span class="text-xs font-normal text-mute">/pp</span>' : ''}</span>
        </div>
        <h3 class="text-sm font-semibold text-ink group-hover:text-link transition-colors leading-snug line-clamp-2">${esc(t.title)}</h3>
        ${t.description ? `<p class="mt-1.5 text-xs text-body line-clamp-2">${esc(t.description.slice(0, 100))}</p>` : ''}
        <div class="mt-3 flex items-center gap-2 flex-wrap text-xs text-mute">
          <span class="flex items-center gap-1">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <span class="truncate max-w-[120px]">${esc(t.location?.split(',')[0] || t.location)}</span>
          </span>
          ${distText ? `<span class="text-link font-medium">${distText}</span>` : ''}
          <span class="flex items-center gap-1 ${deadlineColor}">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
            ${esc(t.deadline || 'Today')}
          </span>
        </div>
        <div class="mt-3 pt-3 border-t border-hairline flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="w-5 h-5 rounded-full bg-canvas-soft-2 flex items-center justify-center text-[8px] font-bold text-body">${t.anonymous ? '?' : esc((t.posterName || 'U')[0].toUpperCase())}</span>
            <span class="text-xs text-body">${t.anonymous ? 'Anonymous' : esc(t.posterName || 'User')}${t.posterVerified ? ' <span class="text-link text-[10px]">✓</span>' : ''}</span>
          </div>
          <span class="px-2 py-0.5 text-[10px] font-medium rounded-full ${t.status === 'open' ? 'bg-cyan-soft text-cyan-deep' : t.status === 'claimed' ? 'bg-warning-soft text-warning-deep' : 'bg-canvas-soft-2 text-mute'}">${esc(t.status)}</span>
        </div>
      </a>`;
    }).join('');
  }

  // Escapes quotes too, so values are safe in attributes as well as content.
  function esc(s: any) {
    if (s === null || s === undefined) return '';
    return String(s)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function showActiveState(name: string) {
    document.getElementById('loc-ask')!.classList.add('hidden');
    document.getElementById('loc-city')!.classList.add('hidden');
    document.getElementById('loc-active')!.classList.remove('hidden');
    document.getElementById('loc-name')!.textContent = name;
  }

  function showCityInput() {
    document.getElementById('loc-ask')!.classList.add('hidden');
    document.getElementById('loc-city')!.classList.remove('hidden');
    document.getElementById('loc-active')!.classList.add('hidden');
  }

  // GPS location
  document.getElementById('location-btn')!.addEventListener('click', () => {
    if (!navigator.geolocation) { showCityInput(); return; }
    (document.getElementById('location-btn') as HTMLButtonElement).textContent = 'Locating...';
    navigator.geolocation.getCurrentPosition(
      (pos) => {
        userLat = pos.coords.latitude;
        userLng = pos.coords.longitude;
        showActiveState('your current location');
        loadTasks(true);
      },
      () => {
        // GPS denied — check if logged-in user has city
        if (currentUser?.city) {
          geocodeCity(currentUser.city);
        } else {
          showCityInput();
        }
      },
      { timeout: 10000 }
    );
  });

  // City search with Nominatim autocomplete
  const cityInput = document.getElementById('city-input') as HTMLInputElement;
  const cityResults = document.getElementById('city-results')!;
  let cityTimeout: any;

  // Live location button (inside city input state)
  document.getElementById('live-location-btn')!.addEventListener('click', () => {
    if (!navigator.geolocation) return;
    const btn = document.getElementById('live-location-btn')!;
    btn.textContent = 'Locating...';
    navigator.geolocation.getCurrentPosition(
      (pos) => {
        userLat = pos.coords.latitude;
        userLng = pos.coords.longitude;
        showActiveState('your live location');
        loadTasks(true);
      },
      () => { btn.textContent = '📍 Use Live Location'; alert('Location access denied. To enable:\n\n• Android Chrome: Tap the lock icon (🔒) in address bar → Site settings → Location → Allow\n\n• iPhone Safari: Settings → Safari → Location → Allow\n\n• Desktop: Click the lock icon in address bar → Location → Allow'); },
      { timeout: 10000 }
    );
  });

  cityInput.addEventListener('input', () => {
    clearTimeout(cityTimeout);
    const q = cityInput.value.trim();
    if (q.length < 2) { cityResults.classList.add('hidden'); return; }
    cityTimeout = setTimeout(() => searchCity(q), 400);
  });

  async function searchCity(q: string) {
    const res = await fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(q)}&limit=5`);
    const data = await res.json();
    if (data.length === 0) { cityResults.classList.add('hidden'); return; }
    // Nominatim results are third-party content, so escape before rendering.
    cityResults.innerHTML = data.map((r: any) =>
      `<div class="px-3 py-2.5 text-sm text-body hover:bg-canvas-soft cursor-pointer border-b border-hairline last:border-0" data-lat="${esc(r.lat)}" data-lng="${esc(r.lon)}" data-name="${esc(String(r.display_name).split(',')[0])}">${esc(r.display_name)}</div>`
    ).join('');
    cityResults.classList.remove('hidden');
    cityResults.querySelectorAll('div').forEach(el => {
      el.addEventListener('click', () => {
        userLat = parseFloat(el.dataset.lat!);
        userLng = parseFloat(el.dataset.lng!);
        showActiveState(el.dataset.name!);
        cityResults.classList.add('hidden');
        loadTasks(true);
      });
    });
  }

  async function geocodeCity(city: string) {
    const res = await fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(city)}&limit=1`);
    const data = await res.json();
    if (data.length > 0) {
      userLat = parseFloat(data[0].lat);
      userLng = parseFloat(data[0].lon);
      showActiveState(city);
      loadTasks(true);
    } else {
      showCityInput();
    }
  }

  // Change location button
  document.getElementById('change-location-btn')!.addEventListener('click', () => {
    showCityInput();
    cityInput.focus();
  });

  // Close dropdown on outside click
  document.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement).closest('#city-input, #city-results')) {
      cityResults.classList.add('hidden');
    }
  });

  // Search — debounced, and now refetches from the server so results are not
  // limited to the rows already on screen.
  let searchTimeout: any;
  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  searchInput.addEventListener('input', () => {
    clearTimeout(searchTimeout);
    searchTimeout = setTimeout(() => {
      searchQuery = searchInput.value.trim();
      syncUrl();
      loadTasks(true);
    }, 350);
  });

  // Enter searches immediately instead of waiting out the debounce.
  searchInput.addEventListener('keydown', (e) => {
    if ((e as KeyboardEvent).key === 'Enter') {
      clearTimeout(searchTimeout);
      searchQuery = searchInput.value.trim();
      syncUrl();
      loadTasks(true);
    }
  });

  // Sort
  document.getElementById('sort-select')!.addEventListener('change', (e) => {
    sortBy = (e.target as HTMLSelectElement).value;
    syncUrl();
    loadTasks(true);
  });

  // Pagination happens on scroll with no visible control, so the page looks
  // unchanged while still being able to reach past the first 20 results.
  if ('IntersectionObserver' in window) {
    new IntersectionObserver((entries) => {
      if (entries[0].isIntersecting && hasMore && !loading) loadTasks(false);
    }, { rootMargin: '400px' }).observe(document.getElementById('load-sentinel')!);
  }

  // Category filter
  document.querySelectorAll('.cat-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.cat-btn').forEach(b => {
        b.classList.remove('bg-primary', 'text-on-primary', 'border-primary', 'active');
        b.classList.add('bg-canvas', 'text-body', 'border-hairline');
      });
      btn.classList.add('bg-primary', 'text-on-primary', 'border-primary', 'active');
      btn.classList.remove('bg-canvas', 'text-body', 'border-hairline');
      activeCategory = (btn as HTMLElement).dataset.cat || 'All';
      syncUrl();
      loadTasks(true);
    });
  });

  // Init: restore any shared query, then resolve location
  async function init() {
    restoreFromUrl();

    const authRes = await fetch('/api/auth/me');
    if (authRes.ok) {
      const { user } = await authRes.json();
      currentUser = user;
      if (user.city) {
        // Auto-sort by the user's registered city. geocodeCity loads tasks itself.
        geocodeCity(user.city);
        return;
      }
    }
    // Not logged in or no city — the API falls back to Cloudflare IP geolocation.
    loadTasks(true);
  }

  init();
</script>
