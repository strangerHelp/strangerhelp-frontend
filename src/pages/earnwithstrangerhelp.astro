---

<Layout title="Earn with StrangerHelp — Available Tasks">
  <Navbar />
  <main class="mx-auto max-w-[1400px] px-4 py-8 md:px-6">
    <div class="text-center mb-8">
      <h1 class="text-3xl font-semibold text-ink tracking-[-1.28px]">Earn Money Helping Strangers</h1>
      <p class="mt-2 text-sm text-body max-w-xl mx-auto">50+ tasks available near you. Claim one, complete it, earn ₹100-500. No investment, no boss.</p>
      <a href="/register" class="mt-4 inline-flex h-11 items-center px-6 text-sm font-medium text-on-primary bg-primary rounded-full hover:opacity-90">Start Earning — Sign Up Free</a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {tasks.map((t) => (
        <div class="group p-5 bg-canvas rounded-lg border border-hairline hover:border-hairline-strong shadow-[0px_1px_1px_#00000005,0px_2px_2px_#0000000a] transition-colors">
          <div class="flex items-center justify-between mb-3">
            <div class="flex items-center gap-1.5">
              <span class="px-2 py-0.5 text-xs font-medium text-body bg-canvas-soft-2 rounded-full">{t.category}</span>
              {t.urgent && <span class="px-2 py-0.5 text-xs font-medium bg-error-soft text-error rounded-full">⚡</span>}
              {t.group && <span class="px-2 py-0.5 text-xs font-medium bg-cyan-soft text-cyan-deep rounded-full">👥 {t.group}</span>}
            </div>
            <span class="text-base font-semibold text-ink">₹{t.budget}{t.group ? '/person' : ''}</span>
          </div>
          <h3 class="text-sm font-semibold text-ink leading-snug">{t.title}</h3>
          <div class="mt-3 flex items-center gap-3 text-xs text-mute">
            <span class="flex items-center gap-1">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
              {t.location}
            </span>
            <span class="text-link font-medium">{t.distance} away</span>
          </div>
          <div class="mt-3 pt-3 border-t border-hairline flex items-center justify-between">
            <span class="text-xs text-body">Anonymous <span class="text-link text-[10px]">✓ Verified</span></span>
            <span class="px-2 py-0.5 text-xs rounded-full bg-cyan-soft text-cyan-deep">open</span>
          </div>
        </div>
      ))}
    </div>

    <div class="mt-12 text-center">
      <p class="text-sm text-body mb-4">Ready to start earning?</p>
      <a href="/register" class="inline-flex h-11 items-center px-6 text-sm font-medium text-on-primary bg-primary rounded-full hover:opacity-90">Sign Up Free — Start Claiming Tasks</a>
    </div>
  </main>
</Layout>
