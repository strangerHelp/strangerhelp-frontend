---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
---

<Layout title="Profile — StrangerHelp">
  <Navbar />
  <main class="mx-auto max-w-[1400px] px-4 py-12 md:px-6">
    <!-- Profile Header -->
    <div class="flex flex-col sm:flex-row items-start gap-6 p-6 bg-canvas rounded-lg border border-hairline">
      <div class="relative">
        <div class="w-20 h-20 rounded-full bg-canvas-soft-2 flex items-center justify-center text-2xl font-semibold text-body">
          AK
        </div>
        <button class="absolute -bottom-1 -right-1 w-7 h-7 flex items-center justify-center bg-primary text-on-primary rounded-full border-2 border-canvas" aria-label="Change avatar">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 19a2 2 0 01-2 2H3a2 2 0 01-2-2V8a2 2 0 012-2h4l2-3h6l2 3h4a2 2 0 012 2z"/><circle cx="12" cy="13" r="4"/></svg>
        </button>
      </div>
      <div class="flex-1">
        <div class="flex items-center gap-3">
          <h1 class="text-xl font-semibold text-ink tracking-tight">Arjun Kumar</h1>
          <span class="inline-flex items-center gap-1 px-2 py-0.5 text-xs font-medium bg-cyan-soft text-cyan-deep rounded-full">
            <svg width="10" height="10" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            Verified
          </span>
        </div>
        <p class="mt-1 text-sm text-body">Delhi NCR • Joined Jan 2026</p>
        <div class="mt-3 flex flex-wrap gap-4 text-sm">
          <div><span class="font-semibold text-ink">47</span> <span class="text-mute">tasks completed</span></div>
          <div><span class="font-semibold text-ink">4.9</span> <span class="text-mute">rating</span></div>
          <div><span class="font-semibold text-ink">820</span> <span class="text-mute">trust score</span></div>
        </div>
      </div>
      <a href="/profile/edit" class="inline-flex h-9 items-center px-4 text-sm font-medium text-ink border border-hairline rounded-md hover:bg-canvas-soft-2 transition-colors">
        Edit Profile
      </a>
    </div>

    <!-- Tabs -->
    <div class="mt-8 flex gap-1 border-b border-hairline">
      <button class="px-4 py-2.5 text-sm font-medium text-ink border-b-2 border-ink -mb-px">Activity</button>
      <button class="px-4 py-2.5 text-sm text-body hover:text-ink -mb-px border-b-2 border-transparent">Tasks Posted</button>
      <button class="px-4 py-2.5 text-sm text-body hover:text-ink -mb-px border-b-2 border-transparent">Tasks Completed</button>
      <button class="px-4 py-2.5 text-sm text-body hover:text-ink -mb-px border-b-2 border-transparent">Badges</button>
    </div>

    <!-- Activity Feed -->
    <div class="mt-6 space-y-4">
      {[
        { action: "Completed task", detail: "Document submission at South Delhi RTO", time: "2 hours ago", type: "complete" },
        { action: "Answered question", detail: "Is the passport office at Nehru Place open today?", time: "5 hours ago", type: "answer" },
        { action: "Posted task", detail: "Need photo of shop signage at Karol Bagh", time: "1 day ago", type: "post" },
        { action: "Earned badge", detail: "Verified Helper — 25 tasks completed", time: "3 days ago", type: "badge" },
      ].map((item) => (
        <div class="flex items-start gap-4 p-4 bg-canvas rounded-lg border border-hairline">
          <div class={`w-8 h-8 flex items-center justify-center rounded-full shrink-0 ${
            item.type === "complete" ? "bg-cyan-soft text-cyan-deep" :
            item.type === "answer" ? "bg-link-bg-soft text-link" :
            item.type === "post" ? "bg-canvas-soft-2 text-ink" :
            "bg-warning-soft text-warning-deep"
          }`}>
            {item.type === "complete" && <svg width="14" height="14" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>}
            {item.type === "answer" && <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>}
            {item.type === "post" && <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>}
            {item.type === "badge" && <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>}
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-sm font-medium text-ink">{item.action}</p>
            <p class="mt-0.5 text-sm text-body truncate">{item.detail}</p>
          </div>
          <span class="text-xs text-mute whitespace-nowrap">{item.time}</span>
        </div>
      ))}
    </div>
  </main>
  <Footer />
</Layout>
