---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
---

<Layout title="Sign Up — StrangerHelp">
  <Navbar />
  <main class="min-h-[calc(100vh-64px)] flex items-center justify-center px-4 py-16">
    <div class="w-full max-w-sm">
      <div class="text-center mb-8">
        <h1 class="text-2xl font-semibold text-ink tracking-[-0.96px]">Create your account.</h1>
        <p class="mt-2 text-sm text-body">Join the community. Start helping or get tasks done.</p>
      </div>

      <div class="p-6 bg-canvas rounded-lg border border-hairline shadow-[0px_2px_2px_#0000000a,0px_8px_8px_-8px_#0000000a]">
        <a href="/api/auth/google" class="w-full h-10 flex items-center justify-center gap-2 text-sm font-medium text-ink bg-canvas border border-hairline rounded-md hover:bg-canvas-soft-2 transition-colors">
          <svg width="18" height="18" viewBox="0 0 24 24"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg>
          Continue with Google
        </a>

        <div class="flex items-center gap-3 my-4">
          <div class="flex-1 h-px bg-hairline"></div>
          <span class="text-xs text-mute">or</span>
          <div class="flex-1 h-px bg-hairline"></div>
        </div>

        <form id="register-form" class="space-y-4">
          <div id="error-msg" class="hidden p-3 text-sm text-error bg-error-soft rounded-md"></div>
          <div>
            <label for="name" class="block text-sm font-medium text-ink mb-1.5">Full Name</label>
            <input type="text" id="name" name="name" required placeholder="Your name" class="w-full h-10 px-3 text-sm bg-canvas border border-hairline rounded-md focus:outline-none focus:border-ink transition-colors placeholder:text-mute" />
          </div>
          <div>
            <label for="email" class="block text-sm font-medium text-ink mb-1.5">Email</label>
            <input type="email" id="email" name="email" required placeholder="you@example.com" class="w-full h-10 px-3 text-sm bg-canvas border border-hairline rounded-md focus:outline-none focus:border-ink transition-colors placeholder:text-mute" />
          </div>
          <div>
            <label for="password" class="block text-sm font-medium text-ink mb-1.5">Password</label>
            <input type="password" id="password" name="password" required minlength="8" placeholder="Min. 8 characters" class="w-full h-10 px-3 text-sm bg-canvas border border-hairline rounded-md focus:outline-none focus:border-ink transition-colors placeholder:text-mute" />
          </div>
          <div>
            <label for="city" class="block text-sm font-medium text-ink mb-1.5">City</label>
            <input type="text" id="city" name="city" required placeholder="e.g., Mumbai, London, New York" class="w-full h-10 px-3 text-sm bg-canvas border border-hairline rounded-md focus:outline-none focus:border-ink transition-colors placeholder:text-mute" />
          </div>
          <div>
            <label for="address" class="block text-sm font-medium text-ink mb-1.5">Address</label>
            <input type="text" id="address" name="address" placeholder="Street, locality" class="w-full h-10 px-3 text-sm bg-canvas border border-hairline rounded-md focus:outline-none focus:border-ink transition-colors placeholder:text-mute" />
          </div>
          <div>
            <label for="country" class="block text-sm font-medium text-ink mb-1.5">Country</label>
            <input type="text" id="country" name="country" required placeholder="e.g., India, USA, UK" class="w-full h-10 px-3 text-sm bg-canvas border border-hairline rounded-md focus:outline-none focus:border-ink transition-colors placeholder:text-mute" />
          </div>
          <button type="submit" id="submit-btn" class="w-full h-10 flex items-center justify-center text-sm font-medium text-on-primary bg-primary rounded-md hover:opacity-90 transition-opacity">
            Create Account
          </button>
        </form>
      </div>

      <p class="mt-6 text-center text-sm text-body">
        Already have an account? <a href="/login" class="text-link hover:text-link-deep font-medium">Log in</a>
      </p>
    </div>
  </main>
</Layout>

<script>
  const form = document.getElementById('register-form') as HTMLFormElement;
  const errorMsg = document.getElementById('error-msg')!;
  const submitBtn = document.getElementById('submit-btn')!;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorMsg.classList.add('hidden');
    submitBtn.textContent = 'Creating account...';
    submitBtn.setAttribute('disabled', 'true');

    const name = (document.getElementById('name') as HTMLInputElement).value;
    const email = (document.getElementById('email') as HTMLInputElement).value;
    const password = (document.getElementById('password') as HTMLInputElement).value;
    const city = (document.getElementById('city') as HTMLInputElement).value;
    const address = (document.getElementById('address') as HTMLInputElement).value;
    const country = (document.getElementById('country') as HTMLInputElement).value;

    if (!city) {
      errorMsg.textContent = 'Please enter your city';
      errorMsg.classList.remove('hidden');
      submitBtn.textContent = 'Create Account';
      submitBtn.removeAttribute('disabled');
      return;
    }

    try {
      const res = await fetch('/api/auth/register', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, email, password, city, address, country }),
      });

      const data = await res.json();

      if (!res.ok) {
        errorMsg.textContent = data.error || 'Registration failed';
        errorMsg.classList.remove('hidden');
        submitBtn.textContent = 'Create Account';
        submitBtn.removeAttribute('disabled');
        return;
      }

      window.location.href = '/dashboard';
    } catch {
      errorMsg.textContent = 'Network error. Please try again.';
      errorMsg.classList.remove('hidden');
      submitBtn.textContent = 'Create Account';
      submitBtn.removeAttribute('disabled');
    }
  });
</script>
