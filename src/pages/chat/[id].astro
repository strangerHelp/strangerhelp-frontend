---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
---

<Layout title="Chat — StrangerHelp">
  <Navbar />
  <main id="chat-app" class="mx-auto max-w-[1400px] h-[calc(100dvh-64px)] flex overflow-hidden">
    <!-- Sidebar: conversations list -->
    <aside id="conv-list" class="w-full md:w-80 md:flex flex-col border-r border-hairline bg-canvas">
      <div class="p-4 border-b border-hairline">
        <h2 class="text-sm font-semibold text-ink">Messages</h2>
      </div>
      <div id="conversations" class="flex-1 overflow-y-auto">
        <p class="p-4 text-sm text-mute">Loading conversations...</p>
      </div>
    </aside>

    <!-- Chat area -->
    <div id="chat-area" class="hidden md:flex flex-1 flex-col bg-canvas-soft min-w-0 overflow-hidden">
      <div id="chat-header" class="flex items-center gap-3 px-4 py-3 border-b border-hairline bg-canvas">
        <button id="back-btn" class="md:hidden p-1 text-body hover:text-ink">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        </button>
        <div id="chat-user-info">
          <p class="text-sm font-medium text-ink" id="chat-name">Select a conversation</p>
          <p class="text-xs text-mute" id="chat-status"></p>
        </div>
      </div>
      <div id="messages-container" class="flex-1 overflow-y-auto p-4 space-y-3"></div>
      <div id="chat-input-area" class="hidden p-3 border-t border-hairline bg-canvas shrink-0">
        <form id="msg-form" class="flex items-center gap-2 max-w-full">
          <label class="shrink-0 p-2 text-mute hover:text-ink cursor-pointer transition-colors">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21.44 11.05l-9.19 9.19a6 6 0 01-8.49-8.49l9.19-9.19a4 4 0 015.66 5.66l-9.2 9.19a2 2 0 01-2.83-2.83l8.49-8.48"/></svg>
            <input type="file" id="file-input" accept="image/*,.pdf,.doc,.docx" class="hidden" multiple />
          </label>
          <input type="text" id="msg-input" placeholder="Type a message..." class="min-w-0 flex-1 h-10 px-3 text-sm bg-canvas-soft border border-hairline rounded-md focus:outline-none focus:border-ink transition-colors placeholder:text-mute" />
          <button type="submit" class="shrink-0 p-2 text-on-primary bg-primary rounded-md hover:opacity-90 transition-opacity">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/></svg>
          </button>
        </form>
        <div id="file-preview" class="hidden mt-2 flex gap-2 flex-wrap"></div>
      </div>
    </div>
  </main>
</Layout>

<script>
  let currentUser: any = null;
  let currentConvId: string | null = null;
  let pollInterval: ReturnType<typeof setInterval> | null = null;
  let peerConnection: RTCPeerConnection | null = null;
  let dataChannel: RTCDataChannel | null = null;
  let pendingFiles: File[] = [];

  // Init
  async function init() {
    const res = await fetch('/api/auth/me');
    if (!res.ok) { window.location.href = '/login'; return; }
    const data = await res.json();
    currentUser = data.user;
    loadConversations();
  }

  async function loadConversations() {
    const res = await fetch('/api/messages');
    if (!res.ok) return;
    const convs = await res.json();
    const container = document.getElementById('conversations')!;
    
    if (convs.length === 0) {
      container.innerHTML = '<p class="p-4 text-sm text-mute">No conversations yet. Claim a task to start chatting!</p>';
      return;
    }

    container.innerHTML = convs.map((c: any) => {
      const otherIdx = c.participants.findIndex((p: string) => p.toString() !== currentUser.id);
      const otherName = c.participantNames?.[otherIdx] || 'User';
      return `<div class="conv-item flex items-start gap-3 p-4 border-b border-hairline hover:bg-canvas-soft cursor-pointer transition-colors" data-id="${c._id}">
        <div class="w-9 h-9 rounded-full bg-canvas-soft-2 flex items-center justify-center text-xs font-semibold text-body shrink-0">${otherName.slice(0,2).toUpperCase()}</div>
        <div class="flex-1 min-w-0">
          <div class="flex items-center justify-between"><span class="text-sm font-medium text-ink truncate">${otherName}</span></div>
          <p class="text-xs text-mute truncate mt-0.5">${c.lastMessage || 'No messages'}</p>
        </div>
      </div>`;
    }).join('');

    container.querySelectorAll('.conv-item').forEach(el => {
      el.addEventListener('click', () => openConversation(el.getAttribute('data-id')!));
    });
  }

  async function openConversation(convId: string) {
    currentConvId = convId;
    
    // Show chat area on mobile
    document.getElementById('conv-list')!.classList.add('hidden', 'md:flex');
    document.getElementById('chat-area')!.classList.remove('hidden');
    document.getElementById('chat-area')!.classList.add('flex');
    document.getElementById('chat-input-area')!.classList.remove('hidden');

    // Load messages
    const res = await fetch(`/api/messages/${convId}`);
    const messages = await res.json();
    renderMessages(messages);

    // Get conversation info for header
    const convRes = await fetch('/api/messages');
    const convs = await convRes.json();
    const conv = convs.find((c: any) => c._id === convId);
    if (conv) {
      const otherIdx = conv.participants.findIndex((p: string) => p.toString() !== currentUser.id);
      document.getElementById('chat-name')!.textContent = conv.participantNames?.[otherIdx] || 'User';
      document.getElementById('chat-status')!.textContent = 'Connected via WebRTC';
    }

    // Start polling for new messages
    if (pollInterval) clearInterval(pollInterval);
    pollInterval = setInterval(() => pollMessages(convId), 3000);

    // Init WebRTC data channel
    initWebRTC(convId);
  }

  function renderMessages(messages: any[]) {
    const container = document.getElementById('messages-container')!;
    container.innerHTML = messages.map((m: any) => {
      const isMe = m.senderId === currentUser.id;
      const time = (window as any).timeOnlyIST(m.createdAt);
      let content = '';
      
      if (m.attachments?.length > 0) {
        content += m.attachments.map((a: string) => {
          const isImage = a.startsWith('data:image') || a.match(/\.(jpg|jpeg|png|gif|webp)$/i);
          const isAudio = a.startsWith('data:audio') || a.match(/\.(webm|mp3|ogg|wav)$/i);
          if (isImage) return `<img src="${a}" onclick="viewImage(this.src)" class="max-w-[200px] rounded-md mt-1 cursor-pointer" loading="lazy" />`;
          if (isAudio) return `<audio controls class="h-8 mt-1 max-w-[200px]" src="${a}"></audio>`;
          return `<a href="${a}" target="_blank" class="text-link underline text-xs">📎 Attachment</a>`;
        }).join('');
      }
      if (m.text) content += `<p class="text-sm">${escapeHtml(m.text)}</p>`;

      return `<div class="flex ${isMe ? 'justify-end' : 'justify-start'}">
        <div class="max-w-[70%] px-3.5 py-2.5 rounded-lg ${isMe ? 'bg-primary text-on-primary rounded-br-none' : 'bg-canvas border border-hairline text-ink rounded-bl-none'}">
          ${content}
          <span class="text-xs ${isMe ? 'opacity-60' : 'text-mute'} mt-1 block">${time}</span>
        </div>
      </div>`;
    }).join('');
    container.scrollTop = container.scrollHeight;
  }

  async function pollMessages(convId: string) {
    if (convId !== currentConvId) return;
    const res = await fetch(`/api/messages/${convId}`);
    if (res.ok) {
      const messages = await res.json();
      renderMessages(messages);
    }
  }

  // WebRTC setup for peer-to-peer data channel
  function initWebRTC(convId: string) {
    if (peerConnection) peerConnection.close();
    
    peerConnection = new RTCPeerConnection({
      iceServers: [{ urls: 'stun:stun.l.google.com:19302' }]
    });

    dataChannel = peerConnection.createDataChannel('chat');
    dataChannel.onmessage = (e) => {
      try {
        const msg = JSON.parse(e.data);
        appendMessage(msg);
      } catch {}
    };

    peerConnection.ondatachannel = (e) => {
      const channel = e.channel;
      channel.onmessage = (ev) => {
        try {
          const msg = JSON.parse(ev.data);
          appendMessage(msg);
        } catch {}
      };
    };

    // Note: Full WebRTC signaling requires a signaling server (WebSocket).
    // For now, messages are persisted via API and polled. 
    // WebRTC data channel provides instant delivery when both peers are connected.
  }

  function appendMessage(msg: any) {
    const container = document.getElementById('messages-container')!;
    const isMe = msg.senderId === currentUser.id;
    const time = (window as any).timeOnlyIST(msg.createdAt || new Date().toISOString());
    let content = '';
    if (msg.attachments?.length > 0) {
      content += msg.attachments.map((a: string) => {
        const isImage = a.startsWith('data:image') || a.match(/\.(jpg|jpeg|png|gif|webp)$/i);
        const isAudio = a.startsWith('data:audio') || a.match(/\.(webm|mp3|ogg|wav)$/i);
        if (isImage) return `<img src="${a}" onclick="viewImage(this.src)" class="max-w-[200px] rounded-md mt-1 cursor-pointer" />`;
        if (isAudio) return `<audio controls class="h-8 mt-1 max-w-[200px]" src="${a}"></audio>`;
        return `<a href="${a}" target="_blank" class="text-link underline text-xs">📎 Attachment</a>`;
      }).join('');
    }
    if (msg.text) content += `<p class="text-sm">${escapeHtml(msg.text)}</p>`;
    
    container.insertAdjacentHTML('beforeend', `<div class="flex ${isMe ? 'justify-end' : 'justify-start'}">
      <div class="max-w-[70%] px-3.5 py-2.5 rounded-lg ${isMe ? 'bg-primary text-on-primary rounded-br-none' : 'bg-canvas border border-hairline text-ink rounded-bl-none'}">
        ${content}
        <span class="text-xs ${isMe ? 'opacity-60' : 'text-mute'} mt-1 block">${time}</span>
      </div>
    </div>`);
    container.scrollTop = container.scrollHeight;
  }

  // Send message
  document.getElementById('msg-form')!.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!currentConvId) return;

    const input = document.getElementById('msg-input') as HTMLInputElement;
    const text = input.value.trim();
    
    if (!text && pendingFiles.length === 0) return;

    let body: FormData | string;
    let headers: Record<string, string> = {};

    if (pendingFiles.length > 0) {
      const fd = new FormData();
      fd.append('text', text);
      const compressed = await (window as any).compressFiles(pendingFiles);
      compressed.forEach((f: File) => fd.append('files', f));
      body = fd;
    } else {
      body = JSON.stringify({ text });
      headers['Content-Type'] = 'application/json';
    }

    const res = await fetch(`/api/messages/${currentConvId}`, {
      method: 'POST',
      headers,
      body,
    });

    if (res.ok) {
      const msg = await res.json();
      appendMessage(msg);
      input.value = '';
      pendingFiles = [];
      document.getElementById('file-preview')!.innerHTML = '';
      document.getElementById('file-preview')!.classList.add('hidden');

      // Also send via WebRTC if connected
      if (dataChannel?.readyState === 'open') {
        dataChannel.send(JSON.stringify(msg));
      }
    }
  });

  // File input
  document.getElementById('file-input')!.addEventListener('change', (e) => {
    const input = e.target as HTMLInputElement;
    if (!input.files) return;
    pendingFiles = Array.from(input.files);
    const preview = document.getElementById('file-preview')!;
    preview.classList.remove('hidden');
    preview.innerHTML = pendingFiles.map(f => 
      `<span class="px-2 py-1 text-xs bg-canvas-soft-2 rounded border border-hairline">${f.name}</span>`
    ).join('');
  });

  // Back button (mobile)
  document.getElementById('back-btn')!.addEventListener('click', () => {
    document.getElementById('conv-list')!.classList.remove('hidden');
    document.getElementById('chat-area')!.classList.add('hidden');
    document.getElementById('chat-area')!.classList.remove('flex');
    if (pollInterval) clearInterval(pollInterval);
  });

  function escapeHtml(str: string) {
    return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  init();
</script>
