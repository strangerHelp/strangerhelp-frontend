---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Admin Panel — StrangerHelp">
  <!-- Hidden until admin access confirmed -->
  <div id="admin-panel" class="hidden flex min-h-screen">
    <!-- Sidebar (hidden on mobile, toggle via button) -->
    <aside id="admin-sidebar" class="hidden md:flex w-56 border-r border-hairline bg-canvas shrink-0 flex-col fixed md:static inset-0 z-50 md:z-auto">
      <div class="p-4 border-b border-hairline flex items-center justify-between">
        <div>
          <a href="/" class="text-ink font-semibold text-sm">StrangerHelp</a>
          <p class="text-xs text-mute mt-0.5">Admin Panel</p>
        </div>
        <button id="close-sidebar" class="md:hidden p-1 text-mute hover:text-ink">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
        </button>
      </div>
      <nav class="flex-1 p-3 space-y-1">
        <button class="admin-tab w-full text-left px-3 py-2 text-sm rounded-md bg-canvas-soft-2 text-ink font-medium" data-tab="overview">Overview</button>
        <button class="admin-tab w-full text-left px-3 py-2 text-sm rounded-md text-body hover:text-ink hover:bg-canvas-soft" data-tab="users">Users</button>
        <button class="admin-tab w-full text-left px-3 py-2 text-sm rounded-md text-body hover:text-ink hover:bg-canvas-soft" data-tab="tasks">Tasks</button>
        <button class="admin-tab w-full text-left px-3 py-2 text-sm rounded-md text-body hover:text-ink hover:bg-canvas-soft" data-tab="reports">Reports</button>
        <button class="admin-tab w-full text-left px-3 py-2 text-sm rounded-md text-body hover:text-ink hover:bg-canvas-soft" data-tab="verification">Verification</button>
        <button class="admin-tab w-full text-left px-3 py-2 text-sm rounded-md text-body hover:text-ink hover:bg-canvas-soft" data-tab="support">Support Chat</button>
      </nav>
      <div class="p-3 border-t border-hairline">
        <a href="/dashboard" class="text-xs text-body hover:text-ink">← Back to App</a>
      </div>
    </aside>

    <!-- Content -->
    <main class="flex-1 min-w-0 p-4 md:p-8 bg-canvas-soft overflow-auto">
      <!-- Mobile sidebar toggle -->
      <button id="open-sidebar" class="md:hidden mb-4 inline-flex items-center gap-2 px-3 py-2 text-sm font-medium text-ink border border-hairline rounded-lg hover:bg-canvas-soft-2">
        <svg width="16" height="16" viewBox="0 0 20 20" fill="none"><path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        Menu
      </button>
      <div id="admin-content">
        <p class="text-sm text-mute">Loading...</p>
      </div>
    </main>
  </div>

  <!-- Shown when user is not admin (outside the hidden panel) -->
  <div id="access-denied" class="hidden min-h-screen flex items-center justify-center bg-canvas-soft">
    <div class="text-center">
      <p class="text-4xl font-semibold text-ink">403</p>
      <p class="mt-2 text-sm text-body">You don't have admin access.</p>
      <a href="/dashboard" class="mt-4 inline-flex h-9 items-center px-4 text-sm font-medium text-on-primary bg-primary rounded-full">Go to Dashboard</a>
    </div>
  </div>
</Layout>

<script>
  let currentTab = 'overview';

  // Sidebar toggle on mobile
  document.getElementById('open-sidebar')?.addEventListener('click', () => {
    const sidebar = document.getElementById('admin-sidebar');
    sidebar?.classList.remove('hidden');
    sidebar?.classList.add('flex');
  });
  document.getElementById('close-sidebar')?.addEventListener('click', () => {
    const sidebar = document.getElementById('admin-sidebar');
    sidebar?.classList.add('hidden');
    sidebar?.classList.remove('flex');
  });

  async function init() {
    const res = await fetch('/api/admin?resource=stats');
    if (res.status === 403) {
      document.getElementById('access-denied')!.classList.remove('hidden');
      return;
    }
    if (!res.ok) { window.location.href = '/login'; return; }
    // Admin confirmed — reveal the full panel
    document.getElementById('admin-panel')!.classList.remove('hidden');
    loadOverview();
  }

  async function loadOverview() {
    const res = await fetch('/api/admin?resource=stats');
    const stats = await res.json();
    const completionRate = stats.tasks > 0 ? Math.round((stats.completedTasks / stats.tasks) * 100) : 0;
    document.getElementById('admin-content')!.innerHTML = `
      <div class="flex items-center justify-between">
        <div>
          <h1 class="text-2xl font-semibold text-ink tracking-[-0.96px]">Admin Dashboard</h1>
          <p class="mt-1 text-sm text-body">Platform health at a glance</p>
        </div>
        <div class="flex gap-2">
          <button onclick="downloadMetricsCSV()" class="h-8 px-3 text-xs font-medium text-ink border border-hairline rounded-md hover:bg-canvas-soft-2">📊 CSV</button>
          <button onclick="downloadMetricsJSON()" class="h-8 px-3 text-xs font-medium text-ink border border-hairline rounded-md hover:bg-canvas-soft-2">📋 JSON</button>
        </div>
      </div>

      <!-- Today's Activity -->
      <div class="mt-6 p-4 bg-cyan-soft/20 rounded-lg border border-cyan/20">
        <p class="text-xs font-medium uppercase text-cyan-deep mb-2">📈 Today's Activity</p>
        <div class="grid grid-cols-3 gap-4">
          <div><p class="text-xl font-bold text-ink">${stats.todayUsers}</p><p class="text-xs text-mute">New Users</p></div>
          <div><p class="text-xl font-bold text-ink">${stats.todayTasks}</p><p class="text-xs text-mute">Tasks Posted</p></div>
          <div><p class="text-xl font-bold text-ink">${stats.weekTasks}</p><p class="text-xs text-mute">This Week</p></div>
        </div>
      </div>

      <!-- Alerts -->
      ${stats.openReports > 0 || stats.pendingClaims > 0 ? `
      <div class="mt-4 p-3 bg-warning-soft rounded-lg border border-warning/20">
        <p class="text-xs font-semibold text-warning-deep">⚠️ Requires Attention</p>
        <div class="mt-1 flex gap-4 text-xs text-body">
          ${stats.openReports > 0 ? `<span>• ${stats.openReports} open report(s)</span>` : ''}
          ${stats.pendingClaims > 0 ? `<span>• ${stats.pendingClaims} pending claim request(s)</span>` : ''}
        </div>
      </div>` : ''}

      <!-- Core Stats -->
      <div class="mt-6 grid grid-cols-2 md:grid-cols-4 gap-3">
        <div class="p-4 bg-canvas rounded-lg border border-hairline">
          <p class="text-xs text-mute font-medium uppercase">Users</p>
          <p class="mt-1 text-2xl font-semibold text-ink">${stats.users}</p>
          <p class="text-xs text-cyan-deep">${stats.verifiedUsers} verified</p>
        </div>
        <div class="p-4 bg-canvas rounded-lg border border-hairline">
          <p class="text-xs text-mute font-medium uppercase">Total Tasks</p>
          <p class="mt-1 text-2xl font-semibold text-ink">${stats.tasks}</p>
          <p class="text-xs text-mute">Avg ₹${stats.avgBudget}/task</p>
        </div>
        <div class="p-4 bg-canvas rounded-lg border border-hairline">
          <p class="text-xs text-mute font-medium uppercase">Messages</p>
          <p class="mt-1 text-2xl font-semibold text-ink">${stats.messages}</p>
          <p class="text-xs text-mute">${stats.conversations} conversations</p>
        </div>
        <div class="p-4 bg-canvas rounded-lg border border-hairline">
          <p class="text-xs text-mute font-medium uppercase">GMV</p>
          <p class="mt-1 text-2xl font-semibold text-ink">₹${stats.totalGMV.toLocaleString()}</p>
          <p class="text-xs text-mute">Completed tasks value</p>
        </div>
      </div>

      <!-- Task Pipeline -->
      <div class="mt-4">
        <p class="text-xs font-medium uppercase text-mute mb-2">Task Pipeline</p>
        <div class="grid grid-cols-4 gap-3">
          <div class="p-3 bg-canvas rounded-lg border border-hairline text-center">
            <p class="text-lg font-bold text-cyan-deep">${stats.openTasks}</p>
            <p class="text-xs text-mute">Open</p>
          </div>
          <div class="p-3 bg-canvas rounded-lg border border-hairline text-center">
            <p class="text-lg font-bold text-warning">${stats.claimedTasks}</p>
            <p class="text-xs text-mute">Claimed</p>
          </div>
          <div class="p-3 bg-canvas rounded-lg border border-hairline text-center">
            <p class="text-lg font-bold text-ink">${stats.completedTasks}</p>
            <p class="text-xs text-mute">Completed</p>
          </div>
          <div class="p-3 bg-canvas rounded-lg border border-hairline text-center">
            <p class="text-lg font-bold ${completionRate >= 50 ? 'text-cyan-deep' : 'text-warning'}">${completionRate}%</p>
            <p class="text-xs text-mute">Rate</p>
          </div>
        </div>
        <!-- Progress bar -->
        <div class="mt-2 w-full h-2 bg-hairline rounded-full overflow-hidden flex">
          <div class="h-full bg-cyan-deep" style="width:${stats.tasks > 0 ? (stats.openTasks/stats.tasks*100) : 0}%"></div>
          <div class="h-full bg-warning" style="width:${stats.tasks > 0 ? (stats.claimedTasks/stats.tasks*100) : 0}%"></div>
          <div class="h-full bg-primary" style="width:${stats.tasks > 0 ? (stats.completedTasks/stats.tasks*100) : 0}%"></div>
        </div>
      </div>

      <!-- Platform Features -->
      <div class="mt-4 grid grid-cols-3 gap-3">
        <div class="p-3 bg-canvas rounded-lg border border-hairline text-center">
          <p class="text-lg font-bold text-ink">${stats.meets}</p>
          <p class="text-xs text-mute">Meets</p>
        </div>
        <div class="p-3 bg-canvas rounded-lg border border-hairline text-center">
          <p class="text-lg font-bold text-ink">${stats.activePaths}</p>
          <p class="text-xs text-mute">Active Paths</p>
        </div>
        <div class="p-3 bg-canvas rounded-lg border border-hairline text-center">
          <p class="text-lg font-bold text-ink">${stats.pendingClaims}</p>
          <p class="text-xs text-mute">Pending Claims</p>
        </div>
      </div>`;
  }

  async function loadUsers() {
    const res = await fetch('/api/admin?resource=users');
    const users = await res.json();
    document.getElementById('admin-content')!.innerHTML = `
      <h1 class="text-2xl font-semibold text-ink tracking-[-0.96px]">Users</h1>
      <p class="mt-1 text-sm text-body">${users.length} registered users</p>
      <div class="mt-6 bg-canvas rounded-lg border border-hairline overflow-x-auto">
        <table class="w-full text-sm min-w-[700px]">
          <thead class="bg-canvas-soft-2 text-xs text-mute uppercase">
            <tr><th class="text-left px-4 py-3">Name</th><th class="text-left px-4 py-3">Email</th><th class="text-left px-4 py-3">City</th><th class="text-left px-4 py-3">Status</th><th class="px-4 py-3">Actions</th></tr>
          </thead>
          <tbody class="divide-y divide-hairline">
            ${users.map((u: any) => `<tr>
              <td class="px-4 py-3 font-medium text-ink">${esc(u.name)}</td>
              <td class="px-4 py-3 text-body">${esc(u.email)}</td>
              <td class="px-4 py-3 text-body">${esc(u.city || '—')}</td>
              <td class="px-4 py-3">${u.banned ? '<span class="text-error text-xs font-medium">Banned</span>' : u.isAdmin ? '<span class="text-cyan-deep text-xs font-medium">Admin</span>' : '<span class="text-xs text-mute">Active</span>'}</td>
              <td class="px-4 py-3 text-center">
                ${u.banned
                  ? `<button onclick="adminAction('unban_user','${u._id}')" class="text-xs text-trust font-medium hover:underline">Unban</button>`
                  : `<button onclick="adminAction('ban_user','${u._id}')" class="text-xs text-error font-medium hover:underline">Ban</button>`}
                ${!u.isAdmin ? ` <button onclick="adminAction('make_admin','${u._id}')" class="text-xs text-accent font-medium hover:underline ml-2">Make Admin</button>` : ''}
                ${!u.isAdmin ? ` <button onclick="adminAction('delete_user','${u._id}')" class="text-xs text-error font-medium hover:underline ml-2">Delete</button>` : ''}
              </td>
            </tr>`).join('')}
          </tbody>
        </table>
      </div>`;
  }

  async function loadTasks() {
    const res = await fetch('/api/admin?resource=tasks');
    const tasks = await res.json();
    document.getElementById('admin-content')!.innerHTML = `
      <h1 class="text-2xl font-semibold text-ink tracking-[-0.96px]">Tasks</h1>
      <p class="mt-1 text-sm text-body">${tasks.length} total tasks</p>
      <div class="mt-6 space-y-2">
        ${tasks.map((t: any) => `<div class="flex items-center gap-4 p-4 bg-canvas rounded-lg border border-hairline">
          <div class="w-2 h-2 rounded-full shrink-0 ${t.status === 'open' ? 'bg-cyan-deep' : t.status === 'claimed' ? 'bg-warning' : 'bg-mute'}"></div>
          <div class="flex-1 min-w-0">
            <p class="text-sm font-medium text-ink truncate">${esc(t.title)}</p>
            <p class="text-xs text-mute">${esc(t.category)} · ${esc(t.location)} · ₹${t.budget} · ${t.status}</p>
          </div>
          <div class="flex gap-2 shrink-0">
            <a href="/tasks/${t._id}" class="text-xs text-trust font-medium hover:underline">View</a>
            <button onclick="adminAction('delete_task','${t._id}')" class="text-xs text-error font-medium hover:underline">Delete</button>
          </div>
        </div>`).join('')}
      </div>`;
  }

  async function loadReports() {
    const res = await fetch('/api/reports');
    const allReports = await res.json();
    cachedReports = allReports;
    const reports = allReports.filter((r: any) => r.type !== 'verification');
    const statusColors: Record<string, string> = { open: 'bg-warning-soft text-warning-deep', reviewing: 'bg-trust-soft text-trust', resolved: 'bg-cyan-soft text-cyan-deep', dismissed: 'bg-canvas-soft-2 text-mute' };

    document.getElementById('admin-content')!.innerHTML = `
      <h1 class="text-2xl font-semibold text-ink tracking-[-0.96px]">Reports</h1>
      <p class="mt-1 text-sm text-body">${reports.length} reports</p>
      <div class="mt-6 space-y-3">
        ${reports.length === 0 ? '<p class="text-sm text-mute py-8 text-center">No reports yet.</p>' : reports.map((r: any) => `<div class="p-4 bg-canvas rounded-lg border border-hairline overflow-hidden">
          <div class="flex items-center justify-between mb-2">
            <div class="flex items-center gap-2">
              <span class="text-xs font-medium uppercase text-mute">${r.type}</span>
              <span class="px-2 py-0.5 text-xs font-medium rounded-full ${statusColors[r.status] || ''}">${r.status}</span>
            </div>
            <span class="text-xs text-mute">${new Date(r.createdAt).toLocaleDateString()}</span>
          </div>
          <p class="text-sm font-medium text-ink truncate">${esc(r.reason)}</p>
          <p class="text-xs text-body mt-1">By: ${esc(r.reporterName)}</p>
          ${r.description && !r.description.startsWith('{') && !r.description.includes('data:image') ? `<p class="text-xs text-body mt-1 p-2 bg-canvas-soft rounded overflow-hidden max-h-12 break-all">${esc(r.description.slice(0, 150))}</p>` : ''}
          ${r.adminNote ? `<p class="text-xs text-accent mt-2 truncate">Note: ${esc(r.adminNote)}</p>` : ''}
          <div class="mt-3 flex gap-2">
            <button onclick="updateReport('${r._id}','reviewing','')" class="text-xs px-2 py-1 rounded border border-hairline hover:bg-canvas-soft-2">Reviewing</button>
            <button onclick="updateReport('${r._id}','resolved',prompt('Admin note:') || '')" class="text-xs px-2 py-1 rounded border border-hairline text-cyan-deep hover:bg-cyan-soft">Resolve</button>
            <button onclick="updateReport('${r._id}','dismissed',prompt('Reason for dismissal:') || '')" class="text-xs px-2 py-1 rounded border border-hairline text-mute hover:bg-canvas-soft-2">Dismiss</button>
          </div>
        </div>`).join('')}
      </div>`;
  }

  async function loadVerification() {
    const res = await fetch('/api/reports');
    const reports = await res.json();
    cachedReports = reports;
    const verifications = reports.filter((r: any) => r.type === 'verification');

    document.getElementById('admin-content')!.innerHTML = `
      <h1 class="text-2xl font-semibold text-ink tracking-[-0.96px]">Verification Requests</h1>
      <p class="mt-1 text-sm text-body">${verifications.length} verification requests</p>
      <div class="mt-6 space-y-3">
        ${verifications.length === 0 ? '<p class="text-sm text-mute py-8 text-center">No verification requests.</p>' : verifications.map((v: any) => {
          let hasImages = false;
          try { const d = JSON.parse(v.description || '{}'); hasImages = !!(d.front || d.selfie); } catch {}
          return `<div class="p-4 bg-canvas rounded-lg border border-hairline">
            <div class="flex items-center justify-between mb-2">
              <span class="text-sm font-medium text-ink">${esc(v.reporterName || v.reporter_name || '')} — ${esc(v.reason)}</span>
              <span class="px-2 py-0.5 text-xs rounded-full ${v.status === 'open' ? 'bg-warning-soft text-warning-deep' : 'bg-cyan-soft text-cyan-deep'}">${v.status}</span>
            </div>
            <p class="text-xs text-mute mb-2">User ID: ${v.reporterId || v.reporter_id}</p>
            ${hasImages ? `<div class="flex gap-2 mb-3">
              <button onclick="viewVerificationDocs('${v._id || v.id}')" class="text-xs px-2 py-1 text-link border border-hairline rounded hover:bg-canvas-soft-2">View Documents</button>
            </div>` : '<p class="text-xs text-mute mb-2">No documents</p>'}
            ${v.status === 'open' ? `<div class="flex gap-2">
              <button onclick="approveVerification('${v.reporterId || v.reporter_id}','${v._id || v.id}')" class="text-xs px-3 py-1.5 rounded bg-primary text-on-primary hover:opacity-90">Approve</button>
              <button onclick="rejectVerification('${v.reporterId || v.reporter_id}','${v._id || v.id}')" class="text-xs px-3 py-1.5 rounded border border-hairline text-error hover:bg-error-soft">Reject</button>
            </div>` : ''}
          </div>`;
        }).join('')}
      </div>`;
  }

  let cachedReports: any[] = [];

  (window as any).viewVerificationDocs = function(reportId: string) {
    const report = cachedReports.find((r: any) => (r._id || r.id) === reportId);
    if (!report) return;
    try {
      const docs = JSON.parse(report.description || '{}');
      // Show first available image in modal
      const img = docs.front || docs.selfie || docs.back;
      if (img) {
        // Create a simple page with all images
        const container = document.createElement('div');
        container.style.cssText = 'position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,.9);overflow:auto;padding:20px;display:flex;flex-direction:column;align-items:center;gap:16px;';
        container.onclick = () => container.remove();
        if (docs.front) { const i = document.createElement('img'); i.src = docs.front; i.style.cssText = 'max-width:90%;max-height:40vh;object-fit:contain;border-radius:8px;'; container.appendChild(i); }
        if (docs.back) { const i = document.createElement('img'); i.src = docs.back; i.style.cssText = 'max-width:90%;max-height:40vh;object-fit:contain;border-radius:8px;'; container.appendChild(i); }
        if (docs.selfie) { const i = document.createElement('img'); i.src = docs.selfie; i.style.cssText = 'max-width:90%;max-height:40vh;object-fit:contain;border-radius:8px;'; container.appendChild(i); }
        const close = document.createElement('p'); close.textContent = 'Tap anywhere to close'; close.style.cssText = 'color:#fff;font-size:12px;margin-top:10px;';
        container.appendChild(close);
        document.body.appendChild(container);
      }
    } catch {}
  };

  (window as any).approveVerification = async function(userId: string, reportId: string) {
    const db = await fetch('/api/admin', { method: 'PATCH', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ action: 'verify_user', id: userId }) });
    await fetch('/api/reports', { method: 'PATCH', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ id: reportId, status: 'resolved', adminNote: 'Verification approved' }) });
    loadVerification();
  };

  (window as any).rejectVerification = async function(userId: string, reportId: string) {
    const reason = prompt('Rejection reason:') || 'Documents unclear';
    await fetch('/api/admin', { method: 'PATCH', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ action: 'reject_verification', id: userId }) });
    await fetch('/api/reports', { method: 'PATCH', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ id: reportId, status: 'dismissed', adminNote: reason }) });
    loadVerification();
  };

  (window as any).updateReport = async function(id: string, status: string, adminNote: string) {
    await fetch('/api/reports', {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id, status, adminNote }),
    });
    loadReports();
  };

  (window as any).adminAction = async function(action: string, id: string) {
    if (!confirm(`Are you sure you want to ${action.replace(/_/g, ' ')}?`)) return;
    try {
      const res = await fetch('/api/admin', {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action, id }),
      });
      if (!res.ok) {
        const data = await res.json().catch(() => ({}));
        alert('Error: ' + (data.error || `Request failed (${res.status})`));
        return;
      }
      // Reload current tab
      if (currentTab === 'users') loadUsers();
      else if (currentTab === 'tasks') loadTasks();
      else loadOverview();
    } catch (e: any) {
      alert('Network error: ' + (e.message || 'Failed to connect'));
    }
  };

  function esc(s: any) { return s === null || s === undefined ? '' : String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;'); }

  /**
   * Quote a value for CSV output.
   *
   * Always quotes and doubles embedded quotes so a comma or newline in user
   * data cannot shift columns. Also prefixes a single quote when the value
   * starts with =, +, - or @, which spreadsheets would otherwise evaluate as a
   * formula when the admin opens the export.
   */
  function csvCell(v: any): string {
    if (v === null || v === undefined) return '""';
    let s = String(v);
    if (/^[=+\-@\t\r]/.test(s)) s = "'" + s;
    return '"' + s.replace(/"/g, '""') + '"';
  }

  // Tab switching
  document.querySelectorAll('.admin-tab').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.admin-tab').forEach(b => {
        b.classList.remove('bg-canvas-soft-2', 'text-ink', 'font-medium');
        b.classList.add('text-body');
      });
      btn.classList.add('bg-canvas-soft-2', 'text-ink', 'font-medium');
      btn.classList.remove('text-body');
      currentTab = (btn as HTMLElement).dataset.tab || 'overview';
      // Close sidebar on mobile after selection
      if (window.innerWidth < 768) {
        const sidebar = document.getElementById('admin-sidebar');
        sidebar?.classList.add('hidden');
        sidebar?.classList.remove('flex');
      }
      if (currentTab === 'overview') loadOverview();
      else if (currentTab === 'users') loadUsers();
      else if (currentTab === 'tasks') loadTasks();
      else if (currentTab === 'reports') loadReports();
      else if (currentTab === 'verification') loadVerification();
      else if (currentTab === 'support') loadSupport();
    });
  });

  async function loadSupport() {
    const res = await fetch('/api/admin/support');
    if (!res.ok) return;
    const convs = await res.json();

    document.getElementById('admin-content')!.innerHTML = `
      <h1 class="text-2xl font-semibold text-ink tracking-[-0.96px]">Support Chat</h1>
      <p class="mt-1 text-sm text-body">${convs.length} support conversations</p>
      <div class="mt-6 space-y-3">
        ${convs.length === 0 ? '<p class="text-sm text-mute py-8 text-center">No support messages yet.</p>' : convs.map((c: any) => `
          <div class="p-4 bg-canvas rounded-lg border border-hairline">
            <div class="flex items-center justify-between mb-2">
              <span class="text-sm font-medium text-ink">${esc(c.user_name)}</span>
              <span class="text-xs text-mute">${c.last_message_at ? new Date(c.last_message_at).toLocaleString() : ''}</span>
            </div>
            <p class="text-xs text-body mb-3">${esc(c.last_message)}</p>
            <button onclick="openSupportChat('${c.id}','${esc(c.user_name)}')" class="text-xs px-3 py-1.5 rounded bg-primary text-on-primary hover:opacity-90">View & Reply</button>
          </div>`).join('')}
      </div>
      <div id="support-chat" class="hidden mt-6 p-4 bg-canvas rounded-lg border border-hairline">
        <div class="flex items-center justify-between mb-3">
          <h3 class="text-sm font-semibold text-ink" id="support-chat-title">Chat</h3>
          <button onclick="document.getElementById('support-chat').classList.add('hidden')" class="text-xs text-mute hover:text-ink">Close</button>
        </div>
        <div id="support-messages" class="max-h-64 overflow-y-auto space-y-2 mb-3"></div>
        <div class="flex gap-2">
          <input type="text" id="support-reply" placeholder="Type reply..." class="flex-1 h-9 px-3 text-sm border border-hairline rounded-md" />
          <button id="support-send" class="h-9 px-4 text-xs font-medium text-on-primary bg-primary rounded-md hover:opacity-90">Send</button>
        </div>
      </div>`;
  }

  let currentSupportConvId = '';
  (window as any).openSupportChat = async function(convId: string, userName: string) {
    currentSupportConvId = convId;
    document.getElementById('support-chat')!.classList.remove('hidden');
    document.getElementById('support-chat-title')!.textContent = `Chat with ${userName}`;
    const res = await fetch(`/api/messages/${convId}`);
    if (!res.ok) return;
    const messages = await res.json();
    document.getElementById('support-messages')!.innerHTML = messages.map((m: any) => `
      <div class="flex ${m.senderId === 'support' ? 'justify-end' : 'justify-start'}">
        <div class="max-w-[70%] px-3 py-2 rounded-lg text-xs ${m.senderId === 'support' ? 'bg-primary text-on-primary' : 'bg-canvas-soft-2 text-ink'}">${esc(m.text)}</div>
      </div>`).join('');
    document.getElementById('support-send')!.onclick = async () => {
      const input = document.getElementById('support-reply') as HTMLInputElement;
      if (!input.value.trim()) return;
      await fetch('/api/admin/support', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ conversationId: currentSupportConvId, text: input.value.trim() }) });
      input.value = '';
      (window as any).openSupportChat(currentSupportConvId, userName);
    };
  };

  (window as any).downloadMetricsCSV = async function() {
    const res = await fetch('/api/admin?resource=stats');
    const stats = await res.json();
    const usersRes = await fetch('/api/admin?resource=users');
    const users = await usersRes.json();
    const tasksRes = await fetch('/api/admin?resource=tasks');
    const tasks = await tasksRes.json();

    const date = new Date().toISOString().split('T')[0];
    let csv = `StrangerHelp Metrics Report - ${date}\n\n`;
    csv += `PLATFORM STATS\n`;
    csv += `Metric,Value\n`;
    csv += `Total Users,${stats.users}\n`;
    csv += `Total Tasks,${stats.tasks}\n`;
    csv += `Open Tasks,${stats.openTasks}\n`;
    csv += `Claimed Tasks,${stats.claimedTasks}\n`;
    csv += `Completed Tasks,${stats.completedTasks}\n`;
    csv += `Total Messages,${stats.messages}\n`;
    csv += `Total Conversations,${stats.conversations}\n`;
    csv += `Completion Rate,${stats.tasks > 0 ? Math.round((stats.completedTasks / stats.tasks) * 100) : 0}%\n`;
    csv += `\nUSERS\n`;
    csv += `Name,Email,City,Status,Joined\n`;
    users.forEach((u: any) => { csv += `${csvCell(u.name)},${csvCell(u.email)},${csvCell(u.city)},${csvCell(u.banned ? 'Banned' : u.isAdmin ? 'Admin' : 'Active')},${csvCell(u.createdAt)}\n`; });
    csv += `\nTASKS\n`;
    csv += `Title,Category,Budget,Location,Status,Posted By,Created\n`;
    tasks.forEach((t: any) => { csv += `${csvCell(t.title)},${csvCell(t.category)},${csvCell(t.budget)},${csvCell(t.location)},${csvCell(t.status)},${csvCell(t.posterName)},${csvCell(t.createdAt)}\n`; });

    const blob = new Blob([csv], { type: 'text/csv' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a'); a.href = url; a.download = `strangerhelp-metrics-${date}.csv`; a.click();
    URL.revokeObjectURL(url);
  };

  (window as any).downloadMetricsJSON = async function() {
    const res = await fetch('/api/admin?resource=stats');
    const stats = await res.json();
    const usersRes = await fetch('/api/admin?resource=users');
    const users = await usersRes.json();
    const tasksRes = await fetch('/api/admin?resource=tasks');
    const tasks = await tasksRes.json();

    const date = new Date().toISOString().split('T')[0];
    const report = {
      generatedAt: new Date().toISOString(),
      platform: 'StrangerHelp',
      stats: { ...stats, completionRate: stats.tasks > 0 ? Math.round((stats.completedTasks / stats.tasks) * 100) : 0 },
      users: users.map((u: any) => ({ name: u.name, email: u.email, city: u.city, status: u.banned ? 'banned' : u.isAdmin ? 'admin' : 'active', joined: u.createdAt })),
      tasks: tasks.map((t: any) => ({ title: t.title, category: t.category, budget: t.budget, location: t.location, status: t.status, postedBy: t.posterName, created: t.createdAt })),
    };

    const blob = new Blob([JSON.stringify(report, null, 2)], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a'); a.href = url; a.download = `strangerhelp-metrics-${date}.json`; a.click();
    URL.revokeObjectURL(url);
  };

  init();
</script>
