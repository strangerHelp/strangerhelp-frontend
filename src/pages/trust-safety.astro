---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Trust & Safety — StrangerHelp">
  <Navbar />
  <main>
    <section class="bg-canvas border-b border-hairline">
      <div class="mx-auto max-w-[1400px] px-4 py-20 md:px-6 md:py-28 text-center">
        <p class="font-medium text-xs text-mute uppercase tracking-wide mb-3">Trust & Safety</p>
        <h1 class="text-3xl md:text-[48px] font-semibold leading-tight md:leading-[48px] tracking-[-2.4px] text-ink max-w-2xl mx-auto">
          Your safety is our priority.
        </h1>
        <p class="mt-5 text-lg text-body max-w-xl mx-auto">
          Multiple layers of protection ensure every interaction on StrangerHelp is safe and secure.
        </p>
      </div>
    </section>

    <section class="bg-canvas-soft">
      <div class="mx-auto max-w-3xl px-4 py-20 md:px-6 md:py-28 space-y-12">
        {[
          { title: "Escrow Payment Protection", desc: "All payments are held in escrow. The helper gets paid only after the task poster verifies completion. No scams, no disputes.", icon: "shield" },
          { title: "Identity Verification (Optional)", desc: "Helpers can verify their identity via Aadhaar eKYC to earn a 'Verified' badge. This is optional but builds trust and unlocks premium tasks.", icon: "id" },
          { title: "Two-Way Ratings", desc: "Both task posters and helpers rate each other after every interaction. Low-rated users are flagged and reviewed.", icon: "star" },
          { title: "Photo Proof with Metadata", desc: "Completion proof photos include geolocation and timestamp metadata. This prevents fake completions and ensures accountability.", icon: "camera" },
          { title: "SOS Emergency Button", desc: "An always-available SOS button shares your real-time location with local authorities. Available to all users during active tasks.", icon: "alert" },
          { title: "Dispute Resolution", desc: "A dedicated resolution team reviews disputes within 24 hours. Clear evidence-based process with photo proof and chat history.", icon: "balance" },
        ].map((item) => (
          <div class="flex items-start gap-5">
            <div class="w-10 h-10 flex items-center justify-center rounded-lg bg-canvas border border-hairline shrink-0">
              {item.icon === "shield" && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-ink"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>}
              {item.icon === "id" && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-ink"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M12 12a3 3 0 100-6 3 3 0 000 6zM6 19c0-2 2.5-3 6-3s6 1 6 3"/></svg>}
              {item.icon === "star" && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-ink"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>}
              {item.icon === "camera" && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-ink"><path d="M23 19a2 2 0 01-2 2H3a2 2 0 01-2-2V8a2 2 0 012-2h4l2-3h6l2 3h4a2 2 0 012 2z"/><circle cx="12" cy="13" r="4"/></svg>}
              {item.icon === "alert" && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-ink"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0zM12 9v4M12 17h.01"/></svg>}
              {item.icon === "balance" && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-ink"><path d="M12 3v18M3 7l9-4 9 4M3 7l3 9h6l3-9M15 7l3 9h3"/></svg>}
            </div>
            <div>
              <h3 class="text-base font-semibold text-ink">{item.title}</h3>
              <p class="mt-1.5 text-sm text-body leading-relaxed">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>
  </main>
  <Footer />
</Layout>
