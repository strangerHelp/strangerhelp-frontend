---
import AccountLayout from "../../layouts/AccountLayout.astro";
---

<AccountLayout title="Profile — StrangerHelp">
  <div class="max-w-lg">
    <!-- Profile Hero Card -->
    <div id="profile-hero" class="p-5 bg-canvas rounded-lg border border-hairline">
      <div class="flex items-center gap-4">
        <div id="hero-avatar" class="w-16 h-16 rounded-full bg-canvas-soft-2 flex items-center justify-center text-xl font-semibold text-body overflow-hidden border-2 border-hairline">
          <span id="hero-initials">...</span>
        </div>
        <div class="flex-1 min-w-0">
          <div class="flex items-center gap-2">
            <h1 id="hero-name" class="text-lg font-semibold text-ink truncate">Loading...</h1>
            <span id="hero-verified" class="hidden text-link text-xs">✓ Verified</span>
          </div>
          <p id="hero-handle" class="text-sm text-mute"></p>
          <p id="hero-city" class="text-xs text-body mt-0.5"></p>
        </div>
      </div>
      <div id="hero-badges" class="mt-3 flex flex-wrap gap-1.5"></div>
    </div>

    <!-- Email verification banner -->
    <div id="verify-email-banner" class="hidden mt-4 p-4 bg-warning-soft rounded-lg border border-warning/20 flex items-center justify-between gap-3">
      <div class="flex items-center gap-3">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-warning-deep shrink-0"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><path d="M22 6l-10 7L2 6"/></svg>
        <div>
          <p class="text-sm font-medium text-ink">Verify your email</p>
          <p class="text-xs text-body">Please verify your email to unlock all features.</p>
        </div>
      </div>
      <button id="send-verify-btn" class="shrink-0 h-8 px-3 text-xs font-medium text-on-primary bg-primary rounded-md hover:opacity-90">Verify Now</button>
    </div>

    <!-- Trust & Rating Stats -->
    <div id="trust-card" class="mt-4 p-5 bg-canvas rounded-lg border border-hairline">
      <div class="flex items-center justify-between mb-3">
        <p class="text-sm font-semibold text-ink">Your Trust Score</p>
        <a id="public-profile-link" href="#" class="text-xs text-link hover:underline">View public profile →</a>
      </div>
      <div id="trust-stats" class="grid grid-cols-4 gap-3 text-center">
        <div><p class="text-lg font-bold text-ink">—</p><p class="text-[10px] text-mute">Rating</p></div>
        <div><p class="text-lg font-bold text-ink">0</p><p class="text-[10px] text-mute">Completed</p></div>
        <div><p class="text-lg font-bold text-ink">0%</p><p class="text-[10px] text-mute">Completion</p></div>
        <div><p class="text-lg font-bold text-ink">0</p><p class="text-[10px] text-mute">Reviews</p></div>
      </div>
      <div class="mt-3 w-full h-2 bg-hairline rounded-full overflow-hidden"><div id="trust-bar" class="h-full bg-gradient-to-r from-cyan-deep to-cyan rounded-full" style="width:0%"></div></div>
      <p id="trust-label" class="mt-1 text-xs text-mute text-right">New</p>
    </div>

    <!-- Quick Actions -->
    <div class="mt-4 grid grid-cols-3 gap-2">
      <a href="/verify" class="p-3 bg-canvas rounded-lg border border-hairline text-center hover:border-hairline-strong transition-colors">
        <p class="text-lg">🪪</p>
        <p class="text-xs text-body mt-1">Verify ID</p>
      </a>
      <a href="/referral" class="p-3 bg-canvas rounded-lg border border-hairline text-center hover:border-hairline-strong transition-colors">
        <p class="text-lg">🎁</p>
        <p class="text-xs text-body mt-1">Refer & Earn</p>
      </a>
      <a href="/karma" class="p-3 bg-canvas rounded-lg border border-hairline text-center hover:border-hairline-strong transition-colors">
        <p class="text-lg">⭐</p>
        <p class="text-xs text-body mt-1">Karma</p>
      </a>
    </div>

    <!-- Edit Profile Section -->
    <h2 class="mt-8 text-base font-semibold text-ink">Edit Profile</h2>
    <p class="mt-1 text-sm text-body">Update your public information.</p>

    <form id="profile-form" class="mt-8 space-y-5">
      <div id="success-msg" class="hidden p-3 text-sm text-cyan-deep bg-cyan-soft rounded-md">Profile updated!</div>
      <div id="error-msg" class="hidden p-3 text-sm text-error bg-error-soft rounded-md"></div>

      <!-- Avatar -->
      <div class="flex items-center gap-4">
        <div class="relative">
          <div id="avatar-preview" class="w-16 h-16 rounded-full bg-canvas-soft-2 flex items-center justify-center text-xl font-semibold text-body overflow-hidden">
            <span id="avatar-initials">...</span>
          </div>
          <label class="absolute -bottom-1 -right-1 w-6 h-6 flex items-center justify-center bg-primary text-on-primary rounded-full border-2 border-canvas cursor-pointer">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 19a2 2 0 01-2 2H3a2 2 0 01-2-2V8a2 2 0 012-2h4l2-3h6l2 3h4a2 2 0 012 2z"/><circle cx="12" cy="13" r="4"/></svg>
            <input type="file" id="avatar" name="avatar" accept="image/*" class="hidden" />
          </label>
        </div>
        <div class="text-sm text-body">Click to upload photo (max 2MB)</div>
      </div>

      <div>
        <label for="name" class="block text-sm font-medium text-ink mb-1.5">Full Name</label>
        <input type="text" id="name" name="name" class="w-full h-10 px-3 text-sm bg-canvas border border-hairline rounded-md focus:outline-none focus:border-ink transition-colors" />
      </div>

      <div>
        <label for="handle" class="block text-sm font-medium text-ink mb-1.5">Username / Handle</label>
        <div class="relative">
          <span class="absolute left-3 top-1/2 -translate-y-1/2 text-sm text-mute">@</span>
          <input type="text" id="handle" name="handle" placeholder="your_handle" class="w-full h-10 pl-7 pr-3 text-sm bg-canvas border border-hairline rounded-md focus:outline-none focus:border-ink transition-colors placeholder:text-mute" />
        </div>
        <p class="mt-1 text-xs text-mute">Unique. Letters, numbers, underscore only. Min 3 chars.</p>
        <p id="handle-error" class="hidden mt-1 text-xs text-error"></p>
      </div>

      <div>
        <label for="bio" class="block text-sm font-medium text-ink mb-1.5">Bio</label>
        <textarea id="bio" name="bio" rows="3" placeholder="A short description..." class="w-full px-3 py-2.5 text-sm bg-canvas border border-hairline rounded-md focus:outline-none focus:border-ink transition-colors placeholder:text-mute resize-none"></textarea>
      </div>

      <div>
        <label for="city" class="block text-sm font-medium text-ink mb-1.5">City</label>
        <input type="text" id="city" name="city" placeholder="e.g., Mumbai, London" class="w-full h-10 px-3 text-sm bg-canvas border border-hairline rounded-md focus:outline-none focus:border-ink transition-colors placeholder:text-mute" />
      </div>

      <div>
        <label for="address" class="block text-sm font-medium text-ink mb-1.5">Address</label>
        <input type="text" id="address" name="address" placeholder="Street, locality" class="w-full h-10 px-3 text-sm bg-canvas border border-hairline rounded-md focus:outline-none focus:border-ink transition-colors placeholder:text-mute" />
      </div>

      <div>
        <label for="country" class="block text-sm font-medium text-ink mb-1.5">Country</label>
        <input type="text" id="country" name="country" placeholder="e.g., India, USA" class="w-full h-10 px-3 text-sm bg-canvas border border-hairline rounded-md focus:outline-none focus:border-ink transition-colors placeholder:text-mute" />
      </div>

      <div>
        <label for="phone" class="block text-sm font-medium text-ink mb-1.5">Phone</label>
        <input type="tel" id="phone" name="phone" placeholder="+91 XXXXX XXXXX" class="w-full h-10 px-3 text-sm bg-canvas border border-hairline rounded-md focus:outline-none focus:border-ink transition-colors placeholder:text-mute" />
      </div>

      <button type="submit" id="submit-btn" class="w-full h-10 flex items-center justify-center text-sm font-medium text-on-primary bg-primary rounded-md hover:opacity-90 transition-opacity">Save Changes</button>
    </form>

    <!-- Verify Identity Link -->
    <div class="mt-8 p-5 bg-canvas rounded-lg border border-hairline">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm font-semibold text-ink">Identity Verification</p>
          <p class="text-xs text-body mt-0.5">Verify your identity to get a trusted badge</p>
        </div>
        <a href="/verify" class="inline-flex h-8 items-center px-3 text-xs font-medium text-on-primary bg-primary rounded-md hover:opacity-90 transition-opacity">Verify Now</a>
      </div>
    </div>
  </div>
</AccountLayout>

<script>
  async function init() {
    const res = await fetch('/api/auth/me');
    if (!res.ok) { window.location.href = '/login'; return; }
    const { user } = await res.json();

    // Show verify email banner if not verified
    if (!user.email_verified) {
      document.getElementById('verify-email-banner')!.classList.remove('hidden');
    }

    // Populate hero card
    document.getElementById('hero-name')!.textContent = user.name || 'User';
    document.getElementById('hero-handle')!.textContent = user.handle ? `@${user.handle}` : '';
    document.getElementById('hero-city')!.textContent = user.city ? `📍 ${user.city}` : '';
    if (user.verified) document.getElementById('hero-verified')!.classList.remove('hidden');
    if (user.avatar) {
      document.getElementById('hero-avatar')!.innerHTML = `<img src="${user.avatar}" class="w-full h-full object-cover" />`;
    } else {
      document.getElementById('hero-initials')!.textContent = (user.name || '?').slice(0, 2).toUpperCase();
    }

    // Badges
    const badges: string[] = [];
    if (user.verified) badges.push('<span class="px-2 py-0.5 text-[10px] font-medium bg-link-bg-soft text-link rounded-full">✓ ID Verified</span>');
    if (user.email_verified) badges.push('<span class="px-2 py-0.5 text-[10px] font-medium bg-cyan-soft text-cyan-deep rounded-full">✓ Email Verified</span>');
    if (user.is_admin) badges.push('<span class="px-2 py-0.5 text-[10px] font-medium bg-violet-soft text-violet-deep rounded-full">Admin</span>');
    document.getElementById('hero-badges')!.innerHTML = badges.join('');

    // Load trust stats
    try {
      const statsRes = await fetch(`/api/users/${user.id}`);
      if (statsRes.ok) {
        const s = await statsRes.json();
        document.getElementById('public-profile-link')!.setAttribute('href', `/user/${user.handle || user.id}`);
        document.getElementById('trust-stats')!.innerHTML = `
          <div><p class="text-lg font-bold text-ink">${s.rating || '—'}</p><p class="text-[10px] text-mute">Rating</p></div>
          <div><p class="text-lg font-bold text-ink">${s.tasksCompleted}</p><p class="text-[10px] text-mute">Completed</p></div>
          <div><p class="text-lg font-bold text-cyan-deep">${s.completionRate}%</p><p class="text-[10px] text-mute">Completion</p></div>
          <div><p class="text-lg font-bold text-ink">${s.totalReviews}</p><p class="text-[10px] text-mute">Reviews</p></div>`;
        const trustPct = Math.min(100, Math.round((s.completionRate * 0.4) + (s.verified ? 20 : 0) + Math.min(s.totalReviews * 4, 40)));
        (document.getElementById('trust-bar') as HTMLElement).style.width = trustPct + '%';
        document.getElementById('trust-label')!.textContent = trustPct >= 80 ? '🟢 Excellent' : trustPct >= 60 ? '🟡 Good' : trustPct >= 30 ? '🟠 Building' : '⚪ New';
      }
    } catch {}

    (document.getElementById('name') as HTMLInputElement).value = user.name || '';
    (document.getElementById('handle') as HTMLInputElement).value = user.handle || '';
    (document.getElementById('bio') as HTMLTextAreaElement).value = user.bio || '';
    (document.getElementById('city') as HTMLInputElement).value = user.city || '';
    (document.getElementById('address') as HTMLInputElement).value = user.area || '';
    (document.getElementById('country') as HTMLInputElement).value = user.country || '';
    (document.getElementById('phone') as HTMLInputElement).value = user.phone || '';

    if (user.avatar) {
      document.getElementById('avatar-preview')!.innerHTML = `<img src="${user.avatar}" class="w-full h-full object-cover" />`;
    } else {
      document.getElementById('avatar-initials')!.textContent = user.name?.slice(0, 2).toUpperCase() || '?';
    }
  }

  document.getElementById('avatar')!.addEventListener('change', (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (file) {
      document.getElementById('avatar-preview')!.innerHTML = `<img src="${URL.createObjectURL(file)}" class="w-full h-full object-cover" />`;
    }
  });

  document.getElementById('profile-form')!.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.getElementById('submit-btn')!;
    btn.textContent = 'Saving...';

    const fd = new FormData();
    fd.append('name', (document.getElementById('name') as HTMLInputElement).value);
    fd.append('handle', (document.getElementById('handle') as HTMLInputElement).value);
    fd.append('bio', (document.getElementById('bio') as HTMLTextAreaElement).value);
    fd.append('city', (document.getElementById('city') as HTMLInputElement).value);
    fd.append('area', (document.getElementById('address') as HTMLInputElement).value);
    fd.append('country', (document.getElementById('country') as HTMLInputElement).value);
    fd.append('phone', (document.getElementById('phone') as HTMLInputElement).value);

    const avatarFile = (document.getElementById('avatar') as HTMLInputElement).files?.[0];
    if (avatarFile) fd.append('avatar', await (window as any).compressImage(avatarFile));

    const res = await fetch('/api/auth/profile', { method: 'POST', body: fd });
    if (res.ok) {
      document.getElementById('success-msg')!.classList.remove('hidden');
      document.getElementById('error-msg')!.classList.add('hidden');
      setTimeout(() => document.getElementById('success-msg')!.classList.add('hidden'), 3000);
    } else {
      const data = await res.json().catch(() => ({ error: 'Failed to update' }));
      document.getElementById('error-msg')!.textContent = data.error || 'Failed to update';
      document.getElementById('error-msg')!.classList.remove('hidden');
    }
    btn.textContent = 'Save Changes';
  });

  // Verify email button
  document.getElementById('send-verify-btn')?.addEventListener('click', async () => {
    const btn = document.getElementById('send-verify-btn')!;
    btn.textContent = 'Sending...';
    const res = await fetch('/api/auth/verify-email', { method: 'POST' });
    if (res.ok) {
      btn.textContent = '✓ Sent!';
      btn.classList.add('opacity-50');
    } else {
      btn.textContent = 'Failed';
    }
  });

  init();
</script>
