---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
---

<Layout title="Live Pulse — StrangerHelp">
  <Navbar />
  <link rel="stylesheet" href="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.css" />
  <main class="relative h-[calc(100vh-64px)] overflow-hidden">
    <div id="pulse-map" class="absolute inset-0 w-full h-full"></div>

    <div class="absolute top-4 left-4 right-4 md:right-auto md:w-80 z-10 space-y-2">
      <div class="p-4 bg-canvas/95 backdrop-blur-md rounded-lg border border-hairline shadow-[0px_8px_16px_-4px_#0000000a]">
        <div class="flex items-center gap-2 mb-3">
          <span class="relative flex h-3 w-3">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-cyan opacity-75"></span>
            <span class="relative inline-flex rounded-full h-3 w-3 bg-cyan-deep"></span>
          </span>
          <h1 class="text-sm font-semibold text-ink">Live Pulse</h1>
          <span class="ml-auto text-xs text-mute font-medium" id="online-count">0 online</span>
        </div>
        <p class="text-xs text-body mb-3">Real-time view of helpers and open tasks near you.</p>

        <div class="flex items-center justify-between p-2.5 bg-canvas-soft rounded-md border border-hairline mb-3">
          <div>
            <p class="text-xs font-medium text-ink">Go Online as Helper</p>
            <p class="text-[10px] text-mute">Share your location to appear on the map</p>
          </div>
          <button id="online-toggle" class="relative w-10 h-6 bg-hairline rounded-full transition-colors" aria-pressed="false">
            <span class="absolute top-1 left-1 w-4 h-4 bg-canvas rounded-full shadow transition-transform"></span>
          </button>
        </div>

        <div class="flex gap-3 text-[10px] text-mute">
          <span class="flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-full bg-cyan-deep"></span> Helpers</span>
          <span class="flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-full bg-warning"></span> Open Tasks</span>
        </div>
      </div>
    </div>

    <div class="absolute bottom-4 left-4 right-4 md:left-auto md:right-4 md:w-80 z-10 space-y-2">
      <div id="tasks-panel" class="max-h-48 overflow-y-auto p-3 bg-canvas/95 backdrop-blur-md rounded-lg border border-hairline shadow-[0px_8px_16px_-4px_#0000000a]">
        <p class="text-xs font-semibold text-ink mb-2">Open Tasks Nearby</p>
        <div id="tasks-list" class="space-y-1.5 text-xs text-body">Loading...</div>
      </div>
      <a href="/tasks/new" class="flex items-center justify-center gap-2 h-11 bg-primary text-on-primary text-sm font-medium rounded-full shadow-lg hover:opacity-90 transition-opacity">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
        Post a Task
      </a>
    </div>
  </main>
  <script is:inline src="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.js"></script>
  <style>
    @keyframes pulse { 0% { transform: scale(1); opacity: 0.7; } 100% { transform: scale(2); opacity: 0; } }
  </style>
  <script is:inline>
    var map, isOnline = false, watchId = null, helperMarkers = [], taskMarkers = [];

    function initPulseMap() {
      map = new maplibregl.Map({
        container: 'pulse-map',
        style: 'https://tiles.openfreemap.org/styles/liberty',
        center: [78.9629, 20.5937],
        zoom: 4.5,
      });
      map.addControl(new maplibregl.NavigationControl(), 'bottom-right');

      if (navigator.geolocation) {
        navigator.geolocation.getCurrentPosition(function(pos) {
          map.flyTo({ center: [pos.coords.longitude, pos.coords.latitude], zoom: 12 });
        }, function() {}, { timeout: 5000 });
      }

      map.on('load', function() { loadPulseData(); });
    }

    function loadPulseData() {
      fetch('/api/pulse').then(function(r) { return r.json(); }).then(function(data) {
        var tasks = data.tasks, helpers = data.helpers;
        document.getElementById('online-count').textContent = helpers.length + ' online';

        helperMarkers.forEach(function(m) { m.remove(); });
        taskMarkers.forEach(function(m) { m.remove(); });
        helperMarkers = [];
        taskMarkers = [];

        helpers.forEach(function(h) {
          var el = document.createElement('div');
          el.style.cssText = 'width:24px;height:24px;position:relative;';
          el.innerHTML = '<div style="position:absolute;inset:-4px;background:rgba(42,157,143,0.3);border-radius:50%;animation:pulse 2s infinite;"></div><div style="width:24px;height:24px;background:#2A9D8F;border-radius:50%;border:3px solid #fff;box-shadow:0 2px 8px rgba(0,0,0,.3);position:relative;z-index:1;"></div>';
          var popup = new maplibregl.Popup({ offset: 14 }).setHTML(
            '<div style="font-size:13px;font-weight:600;">' + esc(h.name) + '</div><div style="font-size:11px;color:#666;">' + esc(h.city || 'Helper') + '</div>'
          );
          var marker = new maplibregl.Marker({ element: el }).setLngLat([h.lng, h.lat]).setPopup(popup).addTo(map);
          helperMarkers.push(marker);
        });

        tasks.forEach(function(t) {
          if (!t.lat || !t.lng) return;
          var el = document.createElement('div');
          el.style.cssText = 'width:16px;height:16px;background:#f5a623;border-radius:50%;border:2px solid #fff;box-shadow:0 2px 6px rgba(0,0,0,.3);cursor:pointer;';
          var popup = new maplibregl.Popup({ offset: 12 }).setHTML(
            '<div style="font-size:13px;font-weight:600;">' + esc(t.title) + '</div><div style="font-size:11px;color:#666;">₹' + t.budget + ' · ' + esc(t.location) + '</div><a href="/tasks/' + t._id + '" style="font-size:11px;color:#101828;">View Task →</a>'
          );
          var marker = new maplibregl.Marker({ element: el }).setLngLat([t.lng, t.lat]).setPopup(popup).addTo(map);
          taskMarkers.push(marker);
        });

        var list = document.getElementById('tasks-list');
        if (tasks.length === 0) {
          list.innerHTML = '<p class="text-mute">No open tasks right now.</p>';
        } else {
          list.innerHTML = tasks.slice(0, 6).map(function(t) {
            return '<a href="/tasks/' + t._id + '" class="flex items-center justify-between p-1.5 rounded hover:bg-canvas-soft-2 transition-colors"><span class="truncate">' + esc(t.title) + '</span><span class="shrink-0 ml-2 font-medium text-ink">₹' + t.budget + '</span></a>';
          }).join('');
        }
      }).catch(function() {});
    }

    // Online toggle
    document.getElementById('online-toggle').addEventListener('click', function() {
      isOnline = !isOnline;
      var toggle = document.getElementById('online-toggle');
      toggle.setAttribute('aria-pressed', String(isOnline));
      toggle.classList.toggle('bg-primary', isOnline);
      toggle.classList.toggle('bg-hairline', !isOnline);
      toggle.querySelector('span').classList.toggle('translate-x-4', isOnline);

      if (isOnline) {
        if (navigator.geolocation) {
          watchId = navigator.geolocation.watchPosition(function(pos) {
            fetch('/api/pulse', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ lat: pos.coords.latitude, lng: pos.coords.longitude }),
            }).then(function() {
              // Refresh the map data immediately so the user sees their own dot
              loadPulseData();
            });
            // Center map on user's location
            map.flyTo({ center: [pos.coords.longitude, pos.coords.latitude], zoom: 13 });
          }, function() { alert('Location access denied. Please enable location services.'); isOnline = false; toggle.setAttribute('aria-pressed', 'false'); toggle.classList.remove('bg-primary'); toggle.classList.add('bg-hairline'); toggle.querySelector('span').classList.remove('translate-x-4'); }, { enableHighAccuracy: true, maximumAge: 30000 });
        }
      } else {
        if (watchId !== null) navigator.geolocation.clearWatch(watchId);
        fetch('/api/pulse', { method: 'DELETE' });
      }
    });

    function esc(s) { return (s === null || s === undefined) ? '' : String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;'); }

    initPulseMap();
    setInterval(loadPulseData, 5000);
  </script>
</Layout>
