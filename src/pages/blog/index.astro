---

<Layout title="Blog — StrangerHelp">
  <Navbar />
  <main class="mx-auto max-w-[1400px] px-4 py-8 md:px-6">
    <div class="max-w-3xl mx-auto">
      <h1 class="text-2xl font-semibold text-ink tracking-[-0.96px]">Blog</h1>
      <p class="mt-2 text-sm text-body">Guides, tips, and stories from the StrangerHelp community.</p>

      <div class="mt-8 space-y-6">
        {blogs.map((post) => (
          <a href={`/blog/${post.slug}`} class="block p-5 bg-canvas rounded-lg border border-hairline hover:border-hairline-strong shadow-[0px_1px_1px_#00000005,0px_2px_2px_#0000000a] transition-colors group">
            <div class="flex items-center gap-2 mb-2">
              <span class="px-2 py-0.5 text-xs font-medium text-body bg-canvas-soft-2 rounded-full">{post.category}</span>
              <span class="text-xs text-mute">{post.date}</span>
            </div>
            <h2 class="text-base font-semibold text-ink group-hover:text-link transition-colors">{post.title}</h2>
            <p class="mt-1.5 text-sm text-body leading-relaxed">{post.excerpt}</p>
          </a>
        ))}
      </div>
    </div>
  </main>
  <Footer />
</Layout>
