---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";

const { slug } = Astro.params;

const posts: Record<string, { title: string; date: string; category: string; content: string }> = {
  "strangers-meet": {
    title: "Strangers Meet: Unite with People Who Care About Real-World Problems",
    date: "2026-06-29",
    category: "Features",
    content: `
      <p>StrangerHelp isn't just about getting errands done. It's about building a community of people who show up — for each other and for their city. <strong>Strangers Meet</strong> is our newest feature that brings people together to tackle real-world problems.</p>
      <h2>What is Strangers Meet?</h2>
      <p>It's a space to organize and join events where strangers come together for a shared purpose — environmental action, community discussions, skill-sharing, or social causes. Think of it as "meetup.com" built into a platform where trust is already established.</p>
      <h2>Public vs Private Meets</h2>
      <ul>
        <li><strong>Public meets</strong> — visible to everyone. Anyone can browse and join. Great for open events like plantation drives, cleanups, and community workshops.</li>
        <li><strong>Private meets</strong> — only accessible via invite link. The organizer shares the link with people they want to invite. Perfect for smaller discussions, study groups, or planning sessions.</li>
      </ul>
      <h2>What You Can Organize</h2>
      <ul>
        <li><strong>🌱 Plantation drives</strong> — "Let's plant 100 trees in Cubbon Park this Saturday"</li>
        <li><strong>🧹 Neighborhood cleanups</strong> — "Beach cleanup at Marina, 6 AM Sunday"</li>
        <li><strong>💬 Problem-solving discussions</strong> — "How do we fix the traffic at Silk Board junction?"</li>
        <li><strong>🎓 Workshops</strong> — "Free photography workshop for beginners"</li>
        <li><strong>🏃 Sports</strong> — "Weekend cricket at Shivaji Park, need 11 players"</li>
        <li><strong>🤝 Social causes</strong> — "Blood donation camp organizing committee"</li>
      </ul>
      <h2>How It Works</h2>
      <ol>
        <li>Go to <a href="/meets/new">Create Meet</a></li>
        <li>Add title, description, category, date, time, location</li>
        <li>Choose Public or Private</li>
        <li>Optionally record a voice note explaining the event</li>
        <li>Set max attendees (2 to 500)</li>
        <li>Share the link — people join</li>
      </ol>
      <h2>Why This Matters</h2>
      <p>Cities are full of people who want to make a difference but don't know where to start. Strangers Meet removes that barrier. You don't need to know anyone — just show up. The trust system from StrangerHelp (verification, ratings, karma) carries over, so you know the people joining are real and accountable.</p>
      <h2>Built on Trust</h2>
      <p>Every attendee has a StrangerHelp profile with a trust score, task history, and optional ID verification. You're not meeting random anonymous accounts — you're meeting verified members of a community that has already proven they show up and get things done.</p>
      <p><a href="/meets">Browse meets happening near you →</a></p>
    `,
  },
  "how-strangerhelp-works": {
    title: "How StrangerHelp Works: Get Tasks Done by Verified Helpers Near You",
    date: "2026-06-20",
    category: "Guide",
    content: `
      <p>StrangerHelp is India's first hyperlocal task marketplace where anyone can post a task that requires physical presence, and a nearby verified helper completes it for a reward.</p>
      <h2>The Problem We Solve</h2>
      <p>Every day, millions of people need simple tasks done at specific locations — submitting documents at a government office, standing in a queue, picking up a parcel, or taking a photo for verification. But they can't always be there physically.</p>
      <h2>How It Works</h2>
      <ol>
        <li><strong>Post a Task</strong> — Describe what you need, set a budget, deadline, and location. You can post anonymously if you prefer.</li>
        <li><strong>Helper Claims It</strong> — A verified helper near the location sees your task and claims it. A chat window opens automatically.</li>
        <li><strong>Task Gets Done</strong> — The helper completes the task, uploads photo proof, and you verify completion.</li>
        <li><strong>Payment & Review</strong> — You pay the helper directly (UPI/cash). Both parties leave reviews to build trust.</li>
      </ol>
      <h2>What Makes Us Different</h2>
      <ul>
        <li><strong>Hyperlocal</strong> — Tasks are location-specific. Helpers are always nearby.</li>
        <li><strong>Verified Users</strong> — ID verification builds trust between strangers.</li>
        <li><strong>Karma System</strong> — Your trust score grows with every successful task.</li>
        <li><strong>Real-time Pulse</strong> — See available helpers on a live map before posting.</li>
      </ul>
    `,
  },
  "why-trust-matters": {
    title: "Why Trust & Verification Matter in Peer-to-Peer Task Platforms",
    date: "2026-06-18",
    category: "Trust & Safety",
    content: `
      <p>When strangers help strangers, trust isn't optional — it's the foundation. Here's how StrangerHelp builds trust at every step.</p>
      <h2>ID Verification</h2>
      <p>Users can submit their government ID (Aadhaar, PAN, Passport, etc.) for verification. Once approved, they receive a blue "✓ Verified" badge visible on all their activity — tasks posted, tasks claimed, and messages.</p>
      <h2>The Karma System</h2>
      <p>Every completed task, positive review, and on-time delivery increases your Karma score. Higher Karma means:</p>
      <ul>
        <li>More visibility when claiming tasks</li>
        <li>Trust from task posters who see your track record</li>
        <li>Priority access to high-budget tasks</li>
      </ul>
      <h2>Mutual Reviews</h2>
      <p>After every task, both the poster and helper rate each other (1-5 stars). These reviews are public and help the community identify reliable users.</p>
      <h2>Reporting & Moderation</h2>
      <p>If something goes wrong, users can report tasks or other users. Our moderation team reviews reports within 24-48 hours and takes action — from warnings to permanent bans.</p>
    `,
  },
