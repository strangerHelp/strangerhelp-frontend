---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  noindex?: boolean;
}

const {
  title = "StrangerHelp — Stranger-to-Stranger Task Assistance | Get Tasks Done Anywhere",
  description = "StrangerHelp is a hyperlocal task marketplace where strangers help strangers. Get document submissions, photo verifications, parcel pickups, and queue standing done by verified helpers near you.",
  image = "https://strangerhelp.com/og-image.png",
  canonical,
  noindex = false,
} = Astro.props;

const canonicalUrl = canonical || new URL(Astro.url.pathname, "https://strangerhelp.com").href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/jpeg" href="/favicon.jpeg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/favicon.jpeg" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- SEO Meta -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="stranger help, task assistance, get tasks done, hyperlocal tasks, document submission help, photo verification, stranger to stranger, task marketplace, crowdsourced information, local help, anonymous task posting, verified helpers" />
    <meta name="author" content="StrangerHelp" />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:site_name" content="StrangerHelp" />
    <meta property="og:locale" content="en" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <!-- Mobile -->
    <meta name="theme-color" content="#101828" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

    <meta name="generator" content={Astro.generator} />

    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-X1JKCFHJ3D" is:inline></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-X1JKCFHJ3D');
    </script>

    <!-- Google Fonts: Space Grotesk (headings) + Inter (body) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <script is:inline>
      const t = localStorage.getItem("theme");
      if (t === "dark" || (!t && window.matchMedia("(prefers-color-scheme: dark)").matches)) {
        document.documentElement.classList.add("dark");
      }
    </script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@600;700&display=swap" rel="stylesheet" />

    <script src="/escape.js" is:inline></script>
    <script src="/compress.js" is:inline></script>
    <script src="/time.js" is:inline></script>
    <script is:inline>
      // Google Translate integration
      function googleTranslateInit() {
        new google.translate.TranslateElement({ pageLanguage: 'en', autoDisplay: false, includedLanguages: 'en,hi,kn,ta,te,bn,mr,ml,gu' }, 'google_translate_element');
      }
      // Auto-translate from URL ?lang= param or localStorage
      (function() {
        var params = new URLSearchParams(window.location.search);
        var lang = params.get('lang') || localStorage.getItem('sh_lang') || 'en';
        if (lang && lang !== 'en') {
          localStorage.setItem('sh_lang', lang);
          // Set Google Translate cookie to trigger translation
          document.cookie = 'googtrans=/en/' + lang + ';path=/';
          document.cookie = 'googtrans=/en/' + lang + ';path=/;domain=' + window.location.hostname;
        }
      })();
    </script>
    <script src="https://translate.google.com/translate_a/element.js?cb=googleTranslateInit" is:inline></script>
    <slot name="head" />
  </head>
  <body class="min-h-screen bg-canvas-soft text-ink">
    <div id="google_translate_element" style="display:none;"></div>
    <slot />
    <!-- Global Image Viewer -->
    <div id="img-viewer" class="hidden fixed inset-0 z-[999] bg-ink/90 flex items-center justify-center p-4" onclick="this.classList.add('hidden')">
      <button class="absolute top-4 right-4 w-10 h-10 flex items-center justify-center text-white text-2xl rounded-full bg-white/10 hover:bg-white/20">✕</button>
      <img id="img-viewer-src" class="max-w-full max-h-[90vh] object-contain rounded-lg" />
    </div>
    <script is:inline>
      window.viewImage = function(src) {
        var v = document.getElementById('img-viewer');
        document.getElementById('img-viewer-src').src = src;
        v.classList.remove('hidden');
      };
    </script>
    <style is:global>
      .goog-te-banner-frame { display: none !important; }
      body { top: 0 !important; }
      .goog-te-gadget { font-size: 0 !important; }
      .skiptranslate { display: none !important; }
      .goog-te-spinner-pos { display: none !important; }
    </style>
  </body>
</html>
