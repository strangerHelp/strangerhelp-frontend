---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  noindex?: boolean;
}

const {
  title = "StrangerHelp — Stranger-to-Stranger Task Assistance | Get Tasks Done Anywhere",
  description = "StrangerHelp is a hyperlocal task marketplace where strangers help strangers. Get document submissions, photo verifications, parcel pickups, and queue standing done by verified helpers near you.",
  image = "https://strangerhelp.com/og-image.png",
  canonical,
  noindex = false,
} = Astro.props;

const canonicalUrl = canonical || new URL(Astro.url.pathname, "https://strangerhelp.com").href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- SEO Meta -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="stranger help, task assistance, get tasks done, hyperlocal tasks, document submission help, photo verification, stranger to stranger, task marketplace, crowdsourced information, local help, anonymous task posting, verified helpers" />
    <meta name="author" content="StrangerHelp" />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:site_name" content="StrangerHelp" />
    <meta property="og:locale" content="en" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <!-- Mobile -->
    <meta name="theme-color" content="#171717" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

    <meta name="generator" content={Astro.generator} />

    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-X1JKCFHJ3D" is:inline></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-X1JKCFHJ3D');
    </script>

    <!-- Geist Font -->
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <script is:inline>
      const t = localStorage.getItem("theme");
      if (t === "dark" || (!t && window.matchMedia("(prefers-color-scheme: dark)").matches)) {
        document.documentElement.classList.add("dark");
      }
    </script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/geist@1.3.1/dist/fonts/geist-sans/style.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/geist@1.3.1/dist/fonts/geist-mono/style.min.css" />

    <script src="/compress.js" is:inline></script>
    <script src="/time.js" is:inline></script>
    <slot name="head" />
  </head>
  <body class="min-h-screen bg-canvas-soft text-ink">
    <slot />
  </body>
</html>
