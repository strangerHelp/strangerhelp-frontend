---
interface Props {
  id: string | number;
  text: string;
  category: string;
  location: string;
  answers: number;
  votes: number;
  time: string;
  verified?: boolean;
}

const { id, text, category, location, answers, votes, time, verified } = Astro.props;
---

<a href={`/ask/${id}`} class="group flex items-start gap-4 p-5 bg-canvas rounded-lg border border-hairline hover:border-hairline-strong shadow-[0px_1px_1px_#00000005] transition-colors">
  <!-- Votes -->
  <div class="flex flex-col items-center gap-1 shrink-0 min-w-[40px]">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-mute"><path d="M18 15l-6-6-6 6"/></svg>
    <span class="text-sm font-semibold text-ink">{votes}</span>
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-mute"><path d="M6 9l6 6 6-6"/></svg>
  </div>

  <!-- Content -->
  <div class="flex-1 min-w-0">
    <div class="flex items-center gap-2 mb-1">
      <span class="px-2 py-0.5 text-xs font-medium text-body bg-canvas-soft-2 rounded-full">{category}</span>
      {verified && (
        <span class="px-2 py-0.5 text-xs font-medium text-cyan-deep bg-cyan-soft rounded-full">Verified</span>
      )}
    </div>
    <h3 class="text-sm font-semibold text-ink group-hover:text-link transition-colors">{text}</h3>
    <div class="mt-2 flex items-center gap-3 text-xs text-mute">
      <span>{location}</span>
      <span>·</span>
      <span>{answers} answers</span>
      <span>·</span>
      <span>{time}</span>
    </div>
  </div>
</a>
