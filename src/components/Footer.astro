---
const columns = [
  {
    title: "Product",
    links: [
      { href: "/tasks", label: "Task Marketplace" },
      { href: "/ask", label: "Ask & Answer" },
      { href: "/how-it-works", label: "How It Works" },
      { href: "/leaderboard", label: "Leaderboard" },
    ],
  },
  {
    title: "Helpers",
    links: [
      { href: "/earnwithstrangerhelp", label: "Become a Helper" },
      { href: "/path", label: "Path Matching" },
      { href: "/pulse", label: "Live Pulse" },
      { href: "/meets", label: "Strangers Meet" },
    ],
  },
  {
    title: "Company",
    links: [
      { href: "/about", label: "About" },
      { href: "/trust-safety", label: "Trust & Safety" },
      { href: "/careers", label: "Careers" },
      { href: "/blog", label: "Blog" },
    ],
  },
  {
    title: "Legal",
    links: [
      { href: "/privacy", label: "Privacy Policy" },
      { href: "/terms", label: "Terms of Service" },
      { href: "/refund", label: "Refund Policy" },
      { href: "/help", label: "Help Center" },
      { href: "/contact", label: "Contact" },
    ],
  },
];
---

<footer class="bg-brand">
  <div class="mx-auto max-w-[1400px] px-4 py-16 md:px-6 md:py-20">
    <!-- Top: Logo + tagline -->
    <div class="mb-12">
      <div class="flex items-center gap-3 mb-4">
        <span class="inline-flex items-center rounded-lg bg-white px-2.5 py-1.5">
          <img src="/logo-navbar.jpeg" alt="StrangerHelp" class="h-8 w-auto" />
        </span>
      </div>
      <p class="text-sm text-white/60 max-w-xs leading-relaxed">
        A hyperlocal task platform for Indian metros. Post a task, a verified neighbour gets it done, photo proof, direct UPI payment.
      </p>
    </div>

    <!-- Link columns -->
    <div class="grid grid-cols-2 gap-8 md:grid-cols-4">
      {columns.map((col) => (
        <div>
          <h3 class="text-xs font-semibold text-white/40 uppercase tracking-wider mb-4">{col.title}</h3>
          <ul class="space-y-2.5">
            {col.links.map((link) => (
              <li>
                <a href={link.href} class="text-sm text-white/70 hover:text-accent transition-colors">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- UPI note -->
    <div class="mt-12 pt-8 border-t border-white/10">
      <p class="text-xs text-white/40 mb-6">💳 Payments are direct P2P via UPI. StrangerHelp does not hold or process any money.</p>
    </div>

    <!-- Bottom -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-xs text-white/50">&copy; 2026 StrangerHelp. All rights reserved. Made in India.</p>
      <div class="flex items-center gap-4">
        <a href="https://x.com/strangerhelp07" target="_blank" rel="noopener" class="text-white/40 hover:text-accent transition-colors" aria-label="X (Twitter)">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        </a>
        <a href="https://github.com/strangerhelp" target="_blank" rel="noopener" class="text-white/40 hover:text-accent transition-colors" aria-label="GitHub">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg>
        </a>
        <a href="https://youtube.com/@strangerhelp07" target="_blank" rel="noopener" class="text-white/40 hover:text-accent transition-colors" aria-label="YouTube">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
        </a>
      </div>
    </div>
  </div>
</footer>
