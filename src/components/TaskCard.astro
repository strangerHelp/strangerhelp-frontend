---
interface Props {
  id: string | number;
  title: string;
  category: string;
  budget: string;
  location: string;
  time: string;
  poster: string;
  rating?: number | null;
  anonymous?: boolean;
}

const { id, title, category, budget, location, time, poster, rating, anonymous } = Astro.props;
---

<a href={`/tasks/${id}`} class="group p-5 bg-canvas rounded-lg border border-hairline hover:border-hairline-strong shadow-[0px_1px_1px_#00000005,0px_2px_2px_#0000000a] transition-colors">
  <div class="flex items-center justify-between mb-3">
    <span class="px-2 py-0.5 text-xs font-medium text-body bg-canvas-soft-2 rounded-full">{category}</span>
    <span class="text-base font-semibold text-ink">{budget}</span>
  </div>
  <h3 class="text-sm font-semibold text-ink group-hover:text-link transition-colors leading-snug">{title}</h3>
  <div class="mt-3 flex items-center gap-3 text-xs text-mute">
    <span class="flex items-center gap-1">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
      {location}
    </span>
    <span class="flex items-center gap-1">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
      {time}
    </span>
  </div>
  <div class="mt-3 pt-3 border-t border-hairline flex items-center justify-between">
    <span class="text-xs text-body">{anonymous ? "Anonymous" : poster}</span>
    {rating && (
      <span class="flex items-center gap-1 text-xs text-body">
        <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor" class="text-warning"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
        {rating}
      </span>
    )}
  </div>
</a>
